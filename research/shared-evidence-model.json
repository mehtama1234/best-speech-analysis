        "phase",
        "prompt",
        "boundary"
      ]
    },
    "learner_observation": {
      "required": [
        "record_id",
        "participant_code",
        "task_responses",
        "consent",
        "claim_boundary"
      ]
    },
    "listener_observation": {
      "required": [
        "record_id",
        "stimulus_id",
        "condition",
        "task_responses",
        "scorer_id_or_blind_code",
        "claim_boundary"
      ]
    },
    "counterexample_observation": {
      "required": [
        "counterexample_id",
        "pattern_id",
        "counterexample_type",
        "evidence_ids",
        "status",
        "alternative_explanation"
      ]
    }
  },
  "status_vocabulary": {
    "evidence": [
      "retained",
      "missing",
      "restricted",
      "unrepaired_caption"
    ],
    "interpretation": [
      "provisional",
      "indeterminate",
      "independently_reviewed",
      "adjudicated"
    ],
    "delivery": [
      "not_available",
      "derived_proxy",
      "internal_bounded",
      "independent_reviewed"
    ],
    "lesson": [
      "draft",
      "practice_hypothesis",
      "teachability_observed",
      "promoted_with_limits"
    ],
    "outcome": [
      "not_run",
      "designed",
      "data_collected",
      "analyzed",
      "replicated"
    ]
  },
  "link_rules": [
    "Every pattern example links to one or more exact transcript_segment IDs.",
    "Every delivery observation links to an exact segment when transcript alignment is claimed; otherwise it must say raw-media-only.",
    "Every mechanism hypothesis is marked as a hypothesis until an outcome protocol supports a narrower claim.",
    "Every practice task links to a pattern and carries a non-fit or safety boundary.",
    "Learner observations and listener observations remain separate entity types and separate claim levels.",
    "Missing, disagreement and indeterminate statuses remain visible to clients."
  ],
  "client_contract": {
    "web": [
      "search by communication problem, job, phrase, modality and status",
      "show exact context before interpretation",
      "show limits, counterexamples and disagreement",
      "never hide missing validation"
    ],
    "mobile": [
      "load the same pattern ID and evidence links",
      "show one bounded practice task and self-check",
      "support text, captioned and asynchronous use",
      "store learner records only with consent and claim boundary"
    ]
  },
