{
  "schema_version": "1.0",
  "model_id": "shared-communication-evidence-model",
  "status": "contract_ready_research_evidence_incomplete",
  "claim_boundary": "This contract lets web and mobile surfaces carry provenance and uncertainty together. The presence of a linked record never promotes a provisional observation to a validated pattern, learning result or listener outcome.",
  "claim_levels": [
    {
      "level": "source_observation",
      "meaning": "Checkable wording, audio, video or setting record."
    },
    {
      "level": "contextual_interpretation",
      "meaning": "Bounded reading supported by surrounding context."
    },
    {
      "level": "candidate_mechanism",
      "meaning": "Hypothesis about why a choice might help; not outcome evidence."
    },
    {
      "level": "provisional_pattern",
      "meaning": "Repeated candidate with denominators and limits; independent review still required here."
    },
    {
      "level": "practice_hypothesis",
      "meaning": "Exercise derived from the candidate; not proof that the source behavior works."
    },
    {
      "level": "learning_evidence",
      "meaning": "Observed learner teachability under a separate protocol."
    },
    {
      "level": "listener_outcome_evidence",
      "meaning": "Observed listener task outcome under a locked matched-stimulus study."
    }
  ],
  "entity_types": {
    "source": {
      "required": [
        "source_id",
        "title",
        "source_url",
        "provenance_status"
      ]
    },
    "transcript_segment": {
      "required": [
        "evidence_id",
        "source_id",
        "text",
        "start_seconds",
        "end_seconds",
        "caption_status"
      ]
    },
    "phrase_form": {
      "required": [
        "phrase_form_id",
        "family",
        "exact_form",
        "recurrence",
        "mechanism_hypothesis",
        "status"
      ]
    },
    "function_observation": {
      "required": [
        "function_observation_id",
        "evidence_ids",
        "raw_label",
        "canonical_job",
        "status"
      ]
    },
    "delivery_observation": {
      "required": [
        "delivery_observation_id",
        "evidence_id",
        "modality",
        "observation",
        "measurement_limit",
        "independence_status"
      ]
    },
    "pattern_card": {
