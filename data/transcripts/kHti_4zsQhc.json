    },
    {
      "text": "ladies and gentlemen,",
      "startMs": "8680",
      "endMs": "14760",
      "startTimeText": "0:08"
    },
    {
      "text": "brothers, sisters, gurus, teachers,",
      "startMs": "10640",
      "endMs": "17600",
      "startTimeText": "0:10"
    },
    {
      "text": "and all the wonderful artists and",
      "startMs": "14760",
      "endMs": "19800",
      "startTimeText": "0:14"
    },
    {
      "text": "performers, the students who have",
      "startMs": "17600",
