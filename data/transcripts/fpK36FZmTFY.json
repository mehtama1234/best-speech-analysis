  "transcript": [
    {
      "text": "[ DOOR CLOSES ]",
      "startMs": "3920",
      "endMs": "4420",
      "startTimeText": "0:03"
    },
    {
      "text": "[ CLOCK TICKING ]",
      "startMs": "4640",
      "endMs": "8840",
      "startTimeText": "0:04"
    },
    {
      "text": "Mr. Wonka?",
      "startMs": "16740",
      "endMs": "17760",
      "startTimeText": "0:16"
    },
    {
      "text": "I am extraordinarily busy, sir.",
      "startMs": "17880",
      "endMs": "19900",
      "startTimeText": "0:17"
    },
    {
      "text": "I just wanted to ask about the chocolate.",
      "startMs": "20300",
      "endMs": "22300",
      "startTimeText": "0:20"
    },
    {
      "text": "The lifetime supply of chocolate for Charlie,",
      "startMs": "22980",
      "endMs": "25760",
      "startTimeText": "0:22"
    },
    {
      "text": "When does he get it?",
      "startMs": "27060",
      "endMs": "28320",
      "startTimeText": "0:27"
    },
    {
      "text": "He doesn't.",
      "startMs": "28600",
      "endMs": "29680",
      "startTimeText": "0:28"
    },
    {
      "text": "Why not?",
      "startMs": "30000",
      "endMs": "31060",
      "startTimeText": "0:30"
    },
    {
      "text": "Because he broke the rules.",
      "startMs": "31200",
      "endMs": "32660",
      "startTimeText": "0:31"
    },
    {
      "text": "What rules? We didn't see any rules, did we, Charlie?",
      "startMs": "33060",
      "endMs": "36180",
      "startTimeText": "0:33"
    },
    {
      "text": "Wrong, sir, wrong!",
      "startMs": "36180",
      "endMs": "37960",
      "startTimeText": "0:36"
    },
    {
      "text": "Under section 37b of the contract signed by him,",
      "startMs": "38340",
      "endMs": "42120",
      "startTimeText": "0:38"
    },
    {
      "text": "it states quite clearly that all offers shall become null and void,",
      "startMs": "42340",
      "endMs": "45960",
      "startTimeText": "0:42"
    },
    {
      "text": "if, and you can read for yourself in this photostatic copy,",
      "startMs": "46200",
      "endMs": "49560",
      "startTimeText": "0:46"
    },
    {
      "text": "\"I, the undersigned, shall forfeit all rights, privileges, and licenses,",
      "startMs": "49880",
      "endMs": "54500",
      "startTimeText": "0:49"
    },
    {
      "text": "\"Herein and herein contained, et cetera et cetera,",
      "startMs": "54580",
      "endMs": "56580",
      "startTimeText": "0:54"
    },
    {
      "text": "\"Fax, mentis, incendium, gloria culpum, et cetera, et cetera,",
      "startMs": "56760",
      "endMs": "61320",
      "startTimeText": "0:56"
    },
    {
      "text": "\"Memo bis punitor delicatum\"!",
      "startMs": "61580",
      "endMs": "63780",
      "startTimeText": "1:01"
    },
    {
      "text": "It's all there, black and white, clear as crystal!",
      "startMs": "64120",
      "endMs": "67280",
      "startTimeText": "1:04"
    },
    {
      "text": "You stole Fizzy Lifting Drinks!",
      "startMs": "67360",
      "endMs": "69660",
      "startTimeText": "1:07"
    },
    {
      "text": "You bumped into the ceiling which now has to be washed and sterilized,",
      "startMs": "69920",
      "endMs": "73780",
      "startTimeText": "1:09"
    },
    {
      "text": "So, you get nothing!",
      "startMs": "73780",
      "endMs": "75780",
      "startTimeText": "1:13"
    },
    {
      "text": "You lose!",
      "startMs": "75860",
      "endMs": "77320",
      "startTimeText": "1:15"
    },
    {
      "text": "Good day, sir!",
      "startMs": "77740",
      "endMs": "79320",
      "startTimeText": "1:17"
    },
    {
      "text": "You're a crook.",
      "startMs": "80420",
      "endMs": "81400",
      "startTimeText": "1:20"
    },
    {
      "text": "You're a cheat and a swindler! That's what you are!",
      "startMs": "82320",
      "endMs": "85120",
      "startTimeText": "1:22"
    },
    {
      "text": "How can you do a thing like this?!",
      "startMs": "85160",
      "endMs": "87260",
      "startTimeText": "1:25"
    },
    {
      "text": "Build up a little boy's hopes,",
      "startMs": "87500",
      "endMs": "88720",
      "startTimeText": "1:27"
    },
    {
      "text": "and then smash all his dreams to pieces?!",
      "startMs": "88720",
      "endMs": "90700",
      "startTimeText": "1:28"
    },
    {
      "text": "You're an inhuman monster!",
      "startMs": "91180",
      "endMs": "92800",
      "startTimeText": "1:31"
    },
    {
      "text": "I said, good day!",
      "startMs": "92900",
      "endMs": "94780",
      "startTimeText": "1:32"
    },
    {
      "text": "Come on, Charlie. Let's get out of here.",
      "startMs": "98940",
      "endMs": "100960",
      "startTimeText": "1:38"
    },
    {
      "text": "I'll get even with him, if it's the last thing I ever do.",
      "startMs": "102160",
      "endMs": "105000",
      "startTimeText": "1:42"
    },
    {
      "text": "Slugworth wants a Gobstopper? He'll get one.",
      "startMs": "105180",
      "endMs": "107940",
      "startTimeText": "1:45"
    },
    {
      "text": "Mr. Wonka?",
      "startMs": "131140",
      "endMs": "133140",
      "startTimeText": "2:11"
    },
    {
      "text": "So shines a good deed in a weary world...",
      "startMs": "140900",
      "endMs": "145420",
      "startTimeText": "2:20"
    },
    {
      "text": "Charlie?",
      "startMs": "147320",
      "endMs": "148200",
      "startTimeText": "2:27"
    },
    {
      "text": "My boy.",
      "startMs": "149800",
      "endMs": "151800",
      "startTimeText": "2:29"
    },
    {
      "text": "You've won! You did it!",
      "startMs": "152320",
      "endMs": "154920",
      "startTimeText": "2:32"
    },
    {
      "text": "You did it!",
      "startMs": "155040",
      "endMs": "156040",
      "startTimeText": "2:35"
    },
    {
      "text": "I knew you would, I just knew you would!",
      "startMs": "156200",
      "endMs": "158580",
      "startTimeText": "2:36"
    },
    {
      "text": "Oh, Charlie, forgive me for putting you through this.",
      "startMs": "159040",
      "endMs": "162260",
      "startTimeText": "2:39"
    },
    {
      "text": "Please, forgive me. Come in, Mr. Wilkinson!",
      "startMs": "162460",
      "endMs": "164640",
      "startTimeText": "2:42"
    },
    {
      "text": "Charlie, meet Mr. Wilkinson.",
      "startMs": "164840",
      "endMs": "166640",
      "startTimeText": "2:44"
    },
    {
      "text": "Pleasure.",
      "startMs": "166740",
      "endMs": "167480",
      "startTimeText": "2:46"
    },
    {
      "text": "Slugworth!",
      "startMs": "167480",
      "endMs": "168100",
      "startTimeText": "2:47"
    },
    {
      "text": "No, no, that's not Slugworth!",
      "startMs": "168180",
      "endMs": "169600",
      "startTimeText": "2:48"
    },
    {
      "text": "He works for me!",
      "startMs": "169600",
      "endMs": "170820",
      "startTimeText": "2:49"
    },
    {
      "text": "For you?",
      "startMs": "171320",
      "endMs": "171820",
      "startTimeText": "2:51"
    },
    {
      "text": "I had to test you, Charlie. And you passed the test.",
      "startMs": "172040",
      "endMs": "175120",
      "startTimeText": "2:52"
    },
    {
      "text": "You won!",
      "startMs": "175560",
      "endMs": "176600",
      "startTimeText": "2:55"
    },
    {
      "text": "[ MUSIC ]",
      "startMs": "177000",
      "endMs": "180300",
      "startTimeText": "2:57"
    }
