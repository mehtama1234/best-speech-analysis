    {
      "text": "पिछले 40 वर्षों में,",
      "startMs": "37409",
      "endMs": "39439",
      "startTimeText": "0:37"
    },
    {
      "text": "मुझे रिलायंस का नेतृत्व करने का सौभाग्य प्राप्त हुआ है।",
      "startMs": "40309",
      "endMs": "44040",
      "startTimeText": "0:40"
    },
    {
      "text": "आज मैं जो कुछ भी हूं रिलायंस की वजह से हूं।",
