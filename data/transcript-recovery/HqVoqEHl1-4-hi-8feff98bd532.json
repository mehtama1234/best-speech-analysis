      "endMs": "49749",
      "startTimeText": "0:45"
    },
    {
      "text": "आज मैं जो कुछ भी जानता हूं वह रिलायंस की बदौलत है।",
      "startMs": "50660",
      "endMs": "55679",
      "startTimeText": "0:50"
    },
    {
      "text": "इस शाम को मैं आपके साथ साझा करना चाहता हूं",
