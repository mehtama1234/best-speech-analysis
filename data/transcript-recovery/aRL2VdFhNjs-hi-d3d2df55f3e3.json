    },
    {
      "text": "आत्मविश्वास बढ़ाने के लिए, कुछ कौशल सीखने के लिए,",
      "startMs": "254120",
      "endMs": "256322",
      "startTimeText": "4:14"
    },
    {
      "text": "और सबसे महत्वपूर्ण बात, कुछ मज़े करो।",
      "startMs": "256322",
      "endMs": "258591",
      "startTimeText": "4:16"
    },
    {
      "text": "पहला संगीत कार्यक्रम जिसमें मैं गया था",
      "startMs": "259759",
      "endMs": "261461",
      "startTimeText": "4:19"
    },
    {
      "text": "मेथड मैन और रेडमैन थे।",
      "startMs": "261461",
      "endMs": "262829",
      "startTimeText": "4:21"
    },
    {
      "text": "यह प्रिस्टिना में था, और मैं 13 वर्ष का था।",
      "startMs": "264130",
      "endMs": "266866",
      "startTimeText": "4:24"
    },
    {
      "text": "यह थोड़ा यादृच्छिक था, वास्तव में अच्छा था,",
      "startMs": "267533",
      "endMs": "269602",
      "startTimeText": "4:27"
    },
    {
      "text": "और निश्चित रूप से काफी उम्र-उपयुक्त नहीं है।",
      "startMs": "269602",
      "endMs": "271738",
      "startTimeText": "4:29"
    },
    {
      "text": "लेकिन ऐसा नहीं था कि मेरे पास शो का कोई वास्तविक विकल्प था।",
      "startMs": "273306",
      "endMs": "275942",
      "startTimeText": "4:33"
    },
    {
      "text": "कोसोवो अभी बहुत छोटा बाजार है",
      "startMs": "275942",
      "endMs": "277810",
      "startTimeText": "4:35"
    },
    {
      "text": "अधिकांश विश्व दौरों में शामिल होने के लिए।",
      "startMs": "277810",
      "endMs": "279912",
      "startTimeText": "4:37"
    },
    {
      "text": "तो अब हम कलाकारों को कोसोवो लाते हैं।",
      "startMs": "280913",
      "endMs": "283616",
      "startTimeText": "4:40"
    },
    {
      "text": "और बिना किसी अपवाद के, सभी को जिन्हें हमने आमंत्रित किया है",
      "startMs": "284183",
      "endMs": "286486",
      "startTimeText": "4:44"
    },
    {
      "text": "सनी हिल फेस्टिवल में परफॉर्म करने के लिए,",
      "startMs": "286486",
      "endMs": "288388",
      "startTimeText": "4:46"
    },
    {
      "text": "माइली साइरस से लेकर केल्विन हैरिस तक,",
      "startMs": "288388",
      "endMs": "290490",
      "startTimeText": "4:48"
    },
    {
      "text": "बस पूरे अनुभव से उड़ा दिया गया है।",
      "startMs": "290823",
      "endMs": "293026",
      "startTimeText": "4:50"
    },
    {
      "text": "वे कहते हैं कि यह सबसे अच्छे शो में से एक है",
      "startMs": "293526",
      "endMs": "294694",
      "startTimeText": "4:53"
    },
    {
      "text": "उन्होंने कभी किया है, क्योंकि ऊर्जा इतनी गर्जना कर रही है,",
      "startMs": "294694",
      "endMs": "297263",
      "startTimeText": "4:54"
    },
    {
      "text": "दर्शक इतने उपस्थित हैं, और स्वागत इतना ईमानदार है।",
      "startMs": "297263",
      "endMs": "300233",
      "startTimeText": "4:57"
    },
    {
      "text": "सबसे अच्छा प्रदर्शन तब होता है जब आपके पास",
      "startMs": "301034",
      "endMs": "302769",
      "startTimeText": "5:01"
    },
    {
      "text": "दर्शकों के साथ वाकई शानदार केमिस्ट्री।",
      "startMs": "302769",
      "endMs": "304871",
      "startTimeText": "5:02"
    },
    {
      "text": "और ऐसा हमेशा सनी हिल पर होता नजर आता है।",
      "startMs": "304871",
      "endMs": "307307",
      "startTimeText": "5:04"
    },
    {
      "text": "हालाँकि, दिखावे भी धोखा दे सकते हैं।",
      "startMs": "308241",
      "endMs": "312045",
      "startTimeText": "5:08"
    },
    {
      "text": "कई मायनों में, कोसोवो में जीवन कठिन है",
      "startMs": "312912",
      "endMs": "316282",
      "startTimeText": "5:12"
    },
    {
      "text": "और यह निर्विवाद रूप से युद्ध के वर्षों के निशान को सहन करता है।",
      "startMs": "316883",
      "endMs": "319952",
      "startTimeText": "5:16"
    },
    {
      "text": "उन लोगों के लिए भी जो दयापूर्वक युद्ध से बच गए,",
      "startMs": "321421",
      "endMs": "323923",
      "startTimeText": "5:21"
    },
    {
      "text": "फिर भी यह अपनी विरासत छोड़ता है।",
      "startMs": "323923",
      "endMs": "325958",
      "startTimeText": "5:23"
    },
    {
      "text": "मेरे माता-पिता ने 1992 में कोसोवो छोड़ दिया क्योंकि तनाव बढ़ रहा था।",
      "startMs": "327026",
      "endMs": "331097",
      "startTimeText": "5:27"
    },
    {
      "text": "जबकि वे काफी भाग्यशाली थे",
      "startMs": "331497",
      "endMs": "332665",
      "startTimeText": "5:31"
    },
    {
      "text": "लंदन में एक अच्छा जीवन बनाने के लिए,",
      "startMs": "332665",
      "endMs": "334167",
      "startTimeText": "5:32"
    },
    {
      "text": "ऐसे साल थे जब वे जानते थे",
      "startMs": "334600",
      "endMs": "336436",
      "startTimeText": "5:34"
    },
    {
      "text": "वे घर नहीं लौट सके।",
      "startMs": "336436",
      "endMs": "337537",
      "startTimeText": "5:36"
    },
    {
      "text": "इससे एक दर्द हुआ होगा जिसकी मैं केवल कल्पना कर सकता हूं।",
      "startMs": "338671",
      "endMs": "341007",
      "startTimeText": "5:38"
    },
    {
      "text": "कभी-कभी जब मैं अपने माता-पिता से बात करता हूं",
      "startMs": "342308",
      "endMs": "343776",
      "startTimeText": "5:42"
    },
    {
      "text": "इस समय के बारे में, वे घंटों बात कर सकते हैं।",
      "startMs": "343776",
      "endMs": "346112",
      "startTimeText": "5:43"
    },
    {
      "text": "और दूसरी बार, यह बहुत थका देने वाला होता है",
      "startMs": "346813",
      "endMs": "349182",
      "startTimeText": "5:46"
    },
    {
      "text": "और वे कहते हैं कि उन्हें लगता है कि वे 300 साल जी चुके हैं।",
      "startMs": "349182",
      "endMs": "352151",
      "startTimeText": "5:49"
    },
    {
      "text": "मेरे लिए, यह दोहरी पहचान होना",
      "startMs": "353486",
      "endMs": "355421",
      "startTimeText": "5:53"
    },
    {
      "text": "वास्तव में सकारात्मक रहा है।",
      "startMs": "355421",
      "endMs": "357090",
      "startTimeText": "5:55"
    },
    {
      "text": "जब लोग टिप्पणी करते हैं तो मैं हमेशा खुश रहता हूं",
      "startMs": "358324",
      "endMs": "360093",
      "startTimeText": "5:58"
    },
    {
      "text": "जिसे वे मेरी अप्रवासी कार्य नीति कहते हैं।",
      "startMs": "360093",
      "endMs": "362462",
      "startTimeText": "6:00"
    },
    {
      "text": "यह सच है। यह एक उपहार है",
      "startMs": "363196",
      "endMs": "364797",
      "startTimeText": "6:03"
    },
    {
      "text": "जो पीढ़ियों से चला आ रहा है।",
      "startMs": "364797",
      "endMs": "366866",
      "startTimeText": "6:04"
    },
    {
      "text": "लेकिन दृढ़ निश्चयी और साहसी राष्ट्रीय भावना के साथ भी,",
      "startMs": "367900",
      "endMs": "370870",
      "startTimeText": "6:07"
    },
    {
      "text": "ठीक होने और एक नया मुकाम खोजने में समय लगता है।",
      "startMs": "370870",
      "endMs": "373406",
      "startTimeText": "6:10"
    },
    {
      "text": "आज भी कोसोवो के सामने कई चुनौतियाँ हैं,",
      "startMs": "374273",
      "endMs": "376876",
      "startTimeText": "6:14"
    },
    {
      "text": "और अक्सर यह युवा पीढ़ी है",
      "startMs": "376876",
      "endMs": "378678",
      "startTimeText": "6:16"
    },
    {
      "text": "जो इसका खामियाजा भुगत रहे हैं।",
      "startMs": "378678",
      "endMs": "379879",
      "startTimeText": "6:18"
    },
    {
      "text": "युवा काम पाने के लिए संघर्ष करते हैं,",
      "startMs": "380980",
      "endMs": "382582",
      "startTimeText": "6:20"
    },
    {
      "text": "और उनके अवसर प्रतिबंधों से बाधित होते हैं",
      "startMs": "382582",
      "endMs": "385218",
      "startTimeText": "6:22"
    },
    {
      "text": "जिससे काम या आनंद के लिए यात्रा करना मुश्किल हो जाता है।",
      "startMs": "385218",
      "endMs": "388054",
      "startTimeText": "6:25"
    },
    {
      "text": "सारे मापदंड पूरे करने के बाद,",
      "startMs": "389088",
      "endMs": "391257",
      "startTimeText": "6:29"
    },
    {
      "text": "यूरोपीय आयोग ने वास्तव में सिफारिश की",
      "startMs": "391758",
      "endMs": "394627",
      "startTimeText": "6:31"
    },
    {
      "text": "तीन साल से अधिक समय से कोसोवो के लिए वीजा उदारीकरण।",
      "startMs": "394627",
      "endMs": "399699",
      "startTimeText": "6:34"
    },
    {
      "text": "तो क्या आपको लगता है कि अब हम इसे पूरा कर सकते हैं? या…",
      "startMs": "401734",
      "endMs": "404704",
      "startTimeText": "6:41"
    },
    {
      "text": "कोसोवो भी सबसे युवा देश",
      "startMs": "409142",
      "endMs": "412011",
      "startTimeText": "6:49"
    },
    {
      "text": "यूरोप में दूसरे तरीके से।",
      "startMs": "412011",
      "endMs": "413346",
      "startTimeText": "6:52"
    },
    {
      "text": "हम सिर्फ 13 छोटे साल के हैं",
      "startMs": "413946",
      "endMs": "416015",
      "startTimeText": "6:53"
    },
    {
      "text": "हमारी आजादी की यात्रा में।",
      "startMs": "416015",
      "endMs": "418017",
      "startTimeText": "6:56"
    },
    {
      "text": "और एक मजबूत अंतरराष्ट्रीय समुदाय के हिस्से के रूप में,",
      "startMs": "418484",
      "endMs": "421120",
      "startTimeText": "6:58"
    },
    {
      "text": "हम भावनात्मक रूप से आगे बढ़ेंगे, हम आर्थिक रूप से विकसित होंगे",
      "startMs": "421120",
      "endMs": "425658",
      "startTimeText": "7:01"
    },
    {
      "text": "और सांस्कृतिक रूप से। यह हमारे डीएनए में है।",
      "startMs": "425658",
      "endMs": "428261",
      "startTimeText": "7:05"
    },
    {
      "text": "जबकि यह अभी भी मेरा दिल तोड़ता है कि यूनाइटेड किंगडम",
      "startMs": "429862",
      "endMs": "432165",
      "startTimeText": "7:09"
    },
    {
      "text": "यूरोपीय संघ छोड़ने का फैसला किया,",
      "startMs": "432165",
      "endMs": "434467",
      "startTimeText": "7:12"
    },
    {
      "text": "इस पर रहने के बजाय,",
      "startMs": "434467",
      "endMs": "436536",
      "startTimeText": "7:14"
    },
    {
      "text": "मुझे याद होगा कि यूरोपीय संघ का पहला उद्देश्य",
      "startMs": "436836",
      "endMs": "440106",
      "startTimeText": "7:16"
    },
    {
      "text": "एकता के माध्यम से शांति सुरक्षित करना है।",
      "startMs": "440606",
      "endMs": "442842",
      "startTimeText": "7:20"
    },
    {
      "text": "क्या यह उचित नहीं होगा यदि कोसोवो कर सके",
      "startMs": "444010",
      "endMs": "446579",
      "startTimeText": "7:24"
    },
    {
      "text": "उस शांतिपूर्ण संघ के भीतर अपना स्थान ले लो,",
      "startMs": "446579",
      "endMs": "448948",
      "startTimeText": "7:26"
    },
    {
      "text": "हमारे पड़ोसियों के साथ आर्थिक रूप से पनपे,",
      "startMs": "449482",
      "endMs": "452285",
      "startTimeText": "7:29"
    },
    {
      "text": "और हाल के संघर्ष की चोट को ठीक करें?",
      "startMs": "452285",
      "endMs": "454854",
      "startTimeText": "7:32"
    },
    {
      "text": "उस दृष्टि को ध्यान में रखते हुए ... धन्यवाद।",
      "startMs": "455755",
      "endMs": "459192",
      "startTimeText": "7:35"
    },
    {
      "text": "इसी दृष्टि को ध्यान में रखते हुए मैं यह पुरस्कार स्वीकार करता हूं",
      "startMs": "464397",
      "endMs": "466999",
      "startTimeText": "7:44"
    },
    {
      "text": "कोसोवो के सभी युवाओं का आभार।",
      "startMs": "466999",
      "endMs": "469769",
      "startTimeText": "7:46"
    },
    {
      "text": "और उनकी ओर से इसे प्राप्त करने के लिए,",
      "startMs": "470136",
      "endMs": "471871",
      "startTimeText": "7:50"
    },
    {
      "text": "मैं कोसोवो के अपने युवा नेता को आमंत्रित करना चाहता हूं,",
      "startMs": "471871",
      "endMs": "474841",
      "startTimeText": "7:51"
    },
    {
      "text": "मंच पर महामहिम राष्ट्रपति वोजोसा उस्मानी।",
      "startMs": "475141",
      "endMs": "478778",
      "startTimeText": "7:55"
    }
  ],
  "quality_status": "timestamped_candidate",
  "review_status": "not_contextually_reviewed",
  "translation_status": "not_independently_verified"
}
