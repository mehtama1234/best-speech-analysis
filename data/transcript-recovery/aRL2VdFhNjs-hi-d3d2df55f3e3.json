    {
      "text": "25 वर्ष से कम आयु का है।",
      "startMs": "112612",
      "endMs": "114247",
      "startTimeText": "1:52"
    },
    {
      "text": "मैं कोसोवो में आधिकारिक तौर पर बूढ़ा हूं।",
      "startMs": "115115",
      "endMs": "116883",
      "startTimeText": "1:55"
    },
    {
      "text": "मैंने हाल ही में एक आगंतुक के बारे में एक कहानी सुनी",
      "startMs": "118818",
      "endMs": "121087",
      "startTimeText": "1:58"
    },
    {
      "text": "वह कोसोवो की राजधानी प्रिस्टिना गया,",
      "startMs": "121087",
      "endMs": "123423",
      "startTimeText": "2:01"
    },
    {
      "text": "छोटे घंटों तक जगाए रखा जा रहा है",
      "startMs": "123656",
      "endMs": "125758",
      "startTimeText": "2:03"
    },
    {
      "text": "अपने होटल के सामने एक बार में एक जीवंत भीड़ द्वारा।",
