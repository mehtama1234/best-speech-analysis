  "attempt_id": "2rmRzAdLgWk-hi-1149654c5986",
  "raw_response_sha256": "c203857669312bf00b7879dad7febc77a76de35a7d310c932cd5cc8c7f890df2",
  "transcript": [
    {
      "text": "आप अपने साथ कैसा व्यवहार करते हैंपत्नी और आपका बच्चा देखता है",
      "startMs": "0",
      "endMs": "2102",
      "startTimeText": "0:00"
    },
    {
      "text": "आप अपनी पत्नी के साथ कैसा व्यवहार करते हैं, और ऐसा ही चल रहा है,",
      "startMs": "2102",
      "endMs": "4070",
      "startTimeText": "0:02"
    },
    {
      "text": "बच्चा जा रहा हैअच्छा सोच कर बड़े हो जाओ,",
      "startMs": "4070",
      "endMs": "5705",
      "startTimeText": "0:04"
    },
    {
      "text": "इस तरह हमएक महिला का इलाज...",
      "startMs": "5705",
      "endMs": "6806",
      "startTimeText": "0:05"
    },
    {
      "text": "आप कैसे...बच्चा कैसे...",
      "startMs": "6806",
      "endMs": "8908",
      "startTimeText": "0:06"
    },
    {
      "text": "के संपर्क में हैपर्यावरण",
      "startMs": "8908",
      "endMs": "10010",
      "startTimeText": "0:08"
    },
    {
      "text": "जहां वे एक महिला को आपत्तिजनक तरीके से देखते हैं",
      "startMs": "10010",
      "endMs": "12078",
      "startTimeText": "0:10"
    },
    {
      "text": "और इस तरह वे सोचते हैं कि यह सामान्य है ...",
      "startMs": "12078",
      "endMs": "14314",
      "startTimeText": "0:12"
    },
    {
      "text": "ऐसा नहीं है कि यह कुछ ऐसा है जो हमें करना है।",
      "startMs": "14314",
      "endMs": "16583",
      "startTimeText": "0:14"
    },
    {
      "text": "यह हमारा कर्तव्य है,क्योंकि तुम अंदर लाए हो",
      "startMs": "16583",
      "endMs": "18618",
      "startTimeText": "0:16"
    },
    {
      "text": "एक जा रहा हैइस दुनिया।",
      "startMs": "18618",
      "endMs": "20220",
      "startTimeText": "0:18"
    },
    {
      "text": "सुनिश्चित करें कि यह करता हैकोई नुकसान न पहुंचाएं,",
      "startMs": "20220",
      "endMs": "22822",
      "startTimeText": "0:20"
    },
    {
      "text": "और उस पर छोड़ दो।",
      "startMs": "22822",
      "endMs": "24057",
      "startTimeText": "0:22"
    },
    {
      "text": "यह ठीक है, जो भी होआगे होता है भगवान पर निर्भर है",
      "startMs": "24057",
      "endMs": "26092",
      "startTimeText": "0:24"
    },
    {
      "text": "और अपनी प्रतिभा।",
      "startMs": "26092",
      "endMs": "27460",
      "startTimeText": "0:26"
    },
    {
      "text": "आमिर सर, उम...",
      "startMs": "27460",
      "endMs": "29596",
      "startTimeText": "0:27"
    },
    {
      "text": "मैं यह नहीं कह सकता कि यह एक सपना सच होना है,",
      "startMs": "29596",
      "endMs": "31564",
      "startTimeText": "0:29"
    },
    {
      "text": "क्योंकि मैंने कभी इस तरह की कल्पना नहीं की थी।",
      "startMs": "31564",
      "endMs": "33466",
      "startTimeText": "0:31"
    },
    {
      "text": "मुझे नहीं पता थायह संभव था,",
      "startMs": "33466",
      "endMs": "35301",
      "startTimeText": "0:33"
    },
    {
      "text": "उह, क्योंकि आप हमेशा से कोई रहे हैं, आप जानते हैं,",
      "startMs": "35802",
      "endMs": "37871",
      "startTimeText": "0:35"
    },
    {
      "text": "मुझे लगता है कि आप दुनिया के एक अलग हिस्से में हैं,",
      "startMs": "38004",
      "endMs": "40507",
      "startTimeText": "0:38"
    },
    {
      "text": "और उह, तुम होपहुंच योग्य नहीं है!",
      "startMs": "40807",
      "endMs": "42442",
      "startTimeText": "0:40"
    },
    {
      "text": "लेकिन आजतुम वहीं हो...",
      "startMs": "42442",
      "endMs": "44077",
      "startTimeText": "0:42"
    },
    {
      "text": "मैं वास्तव में आपसे दो फीट दूर था। तो, यह असली लगता है।",
      "startMs": "44077",
      "endMs": "47747",
      "startTimeText": "0:44"
    },
    {
      "text": "और, उह, उद्योग में आने के बाद, मैंने उह,",
      "startMs": "47981",
      "endMs": "52085",
      "startTimeText": "0:47"
    },
    {
      "text": "मैंने आपके बारे में बहुत सी कहानियाँ सुनी हैं।",
      "startMs": "52085",
      "endMs": "53453",
      "startTimeText": "0:52"
    },
    {
      "text": "उह, कैसे, आप कितने अनुशासित हैं,",
      "startMs": "53953",
      "endMs": "56756",
      "startTimeText": "0:53"
    },
    {
      "text": "और तुम कैसे होएक चरित्र के करीब पहुंचें।",
      "startMs": "56756",
      "endMs": "58925",
      "startTimeText": "0:56"
    },
    {
      "text": "और एक ऐसी ही कहानी थी जो मैंने सुनी",
      "startMs": "59059",
      "endMs": "61428",
      "startTimeText": "0:59"
    },
    {
      "text": "और मुझे उड़ा दिया गया।",
      "startMs": "61428",
      "endMs": "62695",
      "startTimeText": "1:01"
    },
    {
      "text": "जाहिर है, कुछ साल पहले, आपको...",
      "startMs": "63496",
      "endMs": "66699",
      "startTimeText": "1:03"
    },
    {
      "text": "एक वाणिज्यिक का हिस्सा बनें,",
      "startMs": "66699",
      "endMs": "68668",
      "startTimeText": "1:06"
    },
    {
      "text": "कोक के लिए... छोटा कोक...",
      "startMs": "68668",
      "endMs": "70537",
      "startTimeText": "1:08"
    },
    {
      "text": "और आपकी टीमपर आ गया था,",
      "startMs": "70537",
      "endMs": "73606",
      "startTimeText": "1:10"
    },
    {
      "text": "एक प्रस्तुति दें,और जब वे आए,",
      "startMs": "73606",
      "endMs": "77043",
      "startTimeText": "1:13"
    },
    {
      "text": "उन्होंने आपको हैदराबादी पानवाला बजाने के लिए कहा।",
      "startMs": "77043",
      "endMs": "80080",
      "startTimeText": "1:17"
    },
    {
      "text": "और उस समय,",
      "startMs": "80480",
      "endMs": "81314",
      "startTimeText": "1:20"
    },
    {
      "text": "प्रस्तुति थीपर और तुमने कहा,",
      "startMs": "81314",
      "endMs": "83083",
      "startTimeText": "1:21"
    },
    {
      "text": "\"किस तरह का उच्चारण करते हैंतुम चाहते हो कि मेरे पास हो?\"",
      "startMs": "83083",
      "endMs": "85852",
      "startTimeText": "1:23"
    },
    {
      "text": "और फिर उन्होंने कहा, \"सर,बस हैदराबादी पानवाला\"",
      "startMs": "85852",
      "endMs": "88388",
      "startTimeText": "1:25"
    },
    {
      "text": "और आपने यह कहते हुए समाप्त किया कि छह अलग-अलग प्रकार हैं;",
      "startMs": "88388",
      "endMs": "90490",
      "startTimeText": "1:28"
    },
    {
      "text": "और उन्होंने नोट लेना और उस दिन जाना समाप्त कर दिया।",
      "startMs": "90490",
      "endMs": "92792",
      "startTimeText": "1:30"
    },
    {
      "text": "मुझे नहीं पता कि आपको याद है लेकिन",
      "startMs": "93026",
      "endMs": "94160",
      "startTimeText": "1:33"
    },
    {
      "text": "व्यक्तियों कावहाँ कौन था,",
      "startMs": "94160",
      "endMs": "95528",
      "startTimeText": "1:34"
    },
    {
      "text": "उन्होंने मुझे यह बताया और मैं सोच रहा था, \"हे भगवान!\"",
      "startMs": "95995",
      "endMs": "98131",
      "startTimeText": "1:35"
    },
    {
      "text": "मैंने हमेशा सोचा था कि मैं था",
      "startMs": "98364",
      "endMs": "99632",
      "startTimeText": "1:38"
    },
    {
      "text": "पहले तैयारएक विशेष भूमिका,",
      "startMs": "99632",
      "endMs": "101034",
      "startTimeText": "1:39"
    },
    {
      "text": "लेकिन तभी मुझे एहसास हुआ,",
      "startMs": "101034",
      "endMs": "102102",
      "startTimeText": "1:41"
    },
    {
      "text": "अरे तुम, नहीं, ऐसा नहीं हैतैयारी कहा जाता है;",
      "startMs": "102102",
      "endMs": "103636",
      "startTimeText": "1:42"
    },
    {
      "text": "आपको होना चाहिएयह इसके बारे में पता है ... तो ...",
      "startMs": "103636",
      "endMs": "105738",
      "startTimeText": "1:43"
    },
    {
      "text": "आपने प्रेरित कियाहमें इतना और,",
      "startMs": "105738",
      "endMs": "107774",
      "startTimeText": "1:45"
    },
    {
      "text": "मैं, खुशी या गर्व के साथ कहूंगा कि इन सभी दिनों",
      "startMs": "108441",
      "endMs": "111578",
      "startTimeText": "1:48"
    },
    {
      "text": "मैं में थादूसरी तरफ...",
      "startMs": "111578",
      "endMs": "114047",
      "startTimeText": "1:51"
    },
    {
      "text": "मैं दूसरी तरफ था",
      "startMs": "114047",
      "endMs": "114747",
      "startTimeText": "1:54"
    },
    {
      "text": "मैं कहाँ सुनूंगाआपके बारे में कहानियों के लिए।",
      "startMs": "114747",
      "endMs": "116516",
      "startTimeText": "1:54"
    },
    {
      "text": "तो, आज मैं भाग्यशाली हूं औरमैं घर जाता हूं और लोगों को बताता हूं",
      "startMs": "116516",
      "endMs": "119352",
      "startTimeText": "1:56"
    },
    {
      "text": "मैंने सर के साथ समय बिताया और ये कहानियाँ मुझे कहनी हैं।",
      "startMs": "119352",
      "endMs": "122021",
      "startTimeText": "1:59"
    },
    {
      "text": "तो, धन्यवादआज के लिए बहुत कुछ सर।",
      "startMs": "122021",
      "endMs": "123857",
      "startTimeText": "2:02"
    },
    {
      "text": "यह एक सम्मान की बात है किहमारे पास आप यहाँ हैं।",
      "startMs": "123857",
      "endMs": "125725",
      "startTimeText": "2:03"
    },
    {
      "text": "शुक्रियाबहुत ज्यादा।",
      "startMs": "125725",
      "endMs": "126593",
      "startTimeText": "2:05"
    },
    {
      "text": "और, साईं पल्लवी, मुझे पता है कि आपने अभी-अभी बात की है",
      "startMs": "126759",
      "endMs": "128761",
      "startTimeText": "2:06"
    },
    {
      "text": "निष्पक्षता को खारिज करनाक्रीम ... समर्थन।",
      "startMs": "128761",
      "endMs": "131431",
      "startTimeText": "2:08"
    },
    {
      "text": "और आपने कहा कि आपको भी ऐसा लगा, आप जानते हैं,",
      "startMs": "131698",
      "endMs": "133833",
      "startTimeText": "2:11"
    },
    {
      "text": "बाकी से अलगमनोरंजन उद्योग के।",
      "startMs": "133833",
      "endMs": "135935",
      "startTimeText": "2:13"
    },
    {
      "text": "क्या तुम चाहते होके बारे में बात करने के लिए",
      "startMs": "135935",
      "endMs": "137137",
      "startTimeText": "2:15"
    },
    {
      "text": "आप मनोरंजन उद्योग में कैसे आए",
      "startMs": "137137",
      "endMs": "139038",
      "startTimeText": "2:17"
    },
    {
      "text": "और आप अलग क्यों महसूस करते हैं, अंदर आ रहे हैं?",
      "startMs": "139038",
      "endMs": "141474",
      "startTimeText": "2:19"
    },
    {
      "text": "तो, सबसे पहले, यह सिर्फ इतना है कि हम बहुत सारे लोगों को देखते हुए बड़े होते हैं",
      "startMs": "143309",
      "endMs": "146746",
      "startTimeText": "2:23"
    },
    {
      "text": "जिनके पास संपूर्ण विशेषताएं हैं, एक संपूर्ण शरीर...",
      "startMs": "146746",
      "endMs": "149449",
      "startTimeText": "2:26"
    },
    {
      "text": "तो मैं हमेशा सोचता था...",
      "startMs": "149649",
      "endMs": "151017",
      "startTimeText": "2:29"
    },
    {
      "text": "स्क्रीन पर,स्क्रीन पर...",
      "startMs": "151551",
      "endMs": "153186",
      "startTimeText": "2:31"
    },
    {
      "text": "हम उन्हें देखते हैं, और फिर हममहसूस करो कि ओह, वे एकदम सही हैं!",
      "startMs": "153186",
      "endMs": "155655",
      "startTimeText": "2:33"
    },
    {
      "text": "माफ़ कीजिए?ऑनस्क्रीन आप मिलते हैं",
      "startMs": "155655",
      "endMs": "157724",
      "startTimeText": "2:35"
    },
    {
      "text": "उत्तम विशेषताएंऔर परिपूर्ण जीव?",
      "startMs": "158024",
      "endMs": "160527",
      "startTimeText": "2:38"
    },
    {
      "text": "बिल्कुल! वह जो हैहमें विश्वास है, क्योंकि",
      "startMs": "160527",
      "endMs": "162962",
      "startTimeText": "2:40"
    },
    {
      "text": "वह उतनी सुंदर दिखती है, वह उतनी ही गोरी दिखती है,",
      "startMs": "162962",
      "endMs": "164831",
      "startTimeText": "2:42"
    },
    {
      "text": "उसके पास उत्तम विशेषताएं हैं... हम उन्हें मानते हैं",
      "startMs": "164831",
      "endMs": "167534",
      "startTimeText": "2:44"
    },
    {
      "text": "अभिनेता और अभिनेत्रियाँ, तो मैं ऐसा ही था।",
      "startMs": "167534",
      "endMs": "170537",
      "startTimeText": "2:47"
    },
    {
      "text": "मैं देखकर बड़ा हुआ हूं, त्रिशाऔर सिमरन, और वे सब,",
      "startMs": "170537",
      "endMs": "175041",
      "startTimeText": "2:50"
    },
    {
      "text": "उनके पास संपूर्ण आकृति थी, उनके पास महान शरीर था,",
      "startMs": "175041",
      "endMs": "177644",
      "startTimeText": "2:55"
    },
    {
      "text": "लेकिन फिर एक बिंदु था जिस पर मुझे नहीं पता था",
      "startMs": "177644",
      "endMs": "179779",
      "startTimeText": "2:57"
    },
    {
      "text": "क्या मैं अभिनेता बनना चाहता था।",
      "startMs": "179779",
      "endMs": "181247",
      "startTimeText": "2:59"
    },
    {
      "text": "लेकिन वहां, जब मैं अंदर था तो मुझे हमेशा यह असुरक्षा थी",
      "startMs": "181314",
      "endMs": "184817",
      "startTimeText": "3:01"
    },
    {
      "text": "जॉर्जिया दवा कर रहा है ...",
      "startMs": "184817",
      "endMs": "186119",
      "startTimeText": "3:04"
    },
    {
      "text": "तो मैं इन जॉर्जियाई लोगों के साथ था",
      "startMs": "186119",
      "endMs": "187854",
      "startTimeText": "3:06"
    },
    {
      "text": "जो बहुत गोरे थे और फिर उन्हें पिंपल्स नहीं हुए थे,",
      "startMs": "187854",
      "endMs": "190156",
      "startTimeText": "3:07"
    },
    {
      "text": "लेकिन मेरे पास यह सब था।",
      "startMs": "190156",
      "endMs": "191691",
      "startTimeText": "3:10"
    },
    {
      "text": "और मुझे नहीं पता था कि मैं इसे स्वीकार कर सकता हूं",
      "startMs": "191691",
      "endMs": "194127",
      "startTimeText": "3:11"
    },
    {
      "text": "या खुद को स्वीकार करोमैं किसके लिए था।",
      "startMs": "194127",
      "endMs": "195929",
      "startTimeText": "3:14"
    },
    {
      "text": "और फिर वापस आ जाता हूँभारत के लिए, और मैं बहुत खुश हूं",
      "startMs": "196196",
      "endMs": "199098",
      "startTimeText": "3:16"
    },
    {
      "text": "वो अल्फोंसमुझे प्रेमम के लिए चुना।",
      "startMs": "199098",
      "endMs": "201067",
      "startTimeText": "3:19"
    },
    {
      "text": "जिस दिन फिल्म रिलीज हुई, मैं बहुत नर्वस था।",
      "startMs": "201734",
      "endMs": "204037",
      "startTimeText": "3:21"
    },
    {
      "text": "मैं सोच रहा था कि क्या होगा अगर विदेशों में लोग वहां जा रहे हैं",
      "startMs": "204037",
      "endMs": "206573",
      "startTimeText": "3:24"
    },
    {
      "text": "मुझे चिढ़ाते हुए, राग क्या कहने वाला है।",
      "startMs": "206573",
      "endMs": "208174",
      "startTimeText": "3:26"
    },
    {
      "text": "वे स्पष्ट रूप से कहने जा रहे हैं, \"मैं सिमरन की तरह नहीं दिखता,",
      "startMs": "208174",
      "endMs": "209776",
      "startTimeText": "3:28"
    },
    {
      "text": "मैं त्रिशा की तरह नहीं दिखती।\"",
      "startMs": "209776",
      "endMs": "210877",
      "startTimeText": "3:29"
    },
    {
      "text": "तो मेरे लिए एक बुरी खबर आने वाली है...",
      "startMs": "210877",
      "endMs": "212545",
      "startTimeText": "3:30"
    },
    {
      "text": "और फिर, मैं समाप्त हो गयाट्वीट देखना",
      "startMs": "212712",
      "endMs": "214614",
      "startTimeText": "3:32"
    },
    {
      "text": "मेरे जाने के बादवापस जॉर्जिया के लिए,",
      "startMs": "214614",
      "endMs": "216015",
      "startTimeText": "3:34"
    },
    {
      "text": "लोग थेवास्तव में खुश",
      "startMs": "216015",
      "endMs": "217684",
      "startTimeText": "3:36"
    },
    {
      "text": "किसीको देख रहाँ हूँअपनी ही त्वचा में,",
      "startMs": "217684",
      "endMs": "219519",
      "startTimeText": "3:37"
    },
    {
      "text": "और इससे मुझे अपने बारे में इतना आत्मविश्वास महसूस हुआ,",
      "startMs": "219519",
      "endMs": "222855",
      "startTimeText": "3:39"
    },
    {
      "text": "और फिर मैंने सोचा, ठीक है शायद बस इतना ही।",
      "startMs": "222855",
      "endMs": "224924",
      "startTimeText": "3:42"
    },
    {
      "text": "शायद अगर वहाँ कोई है,",
      "startMs": "224924",
      "endMs": "226359",
      "startTimeText": "3:44"
    },
    {
      "text": "बहुत से लोग बहुत खुश महसूस करेंगे कि वे कैसे दिखते हैं।",
      "startMs": "226359",
      "endMs": "228995",
      "startTimeText": "3:46"
    },
    {
      "text": "तो जब मैं इंडस्ट्री में आया तो मुझे ऐसा ही लगा,",
      "startMs": "229362",
      "endMs": "232031",
      "startTimeText": "3:49"
    },
    {
      "text": "और मैं धन्य हूं किमैंने निर्देशकों के साथ काम किया",
      "startMs": "232031",
      "endMs": "234367",
      "startTimeText": "3:52"
    },
    {
      "text": "जिसने मुझे अपनी त्वचा में पसंद किया;",
      "startMs": "234367",
      "endMs": "235835",
      "startTimeText": "3:54"
    },
    {
      "text": "और उनके पास थामैंने पहले मेकअप लगाया,",
      "startMs": "235835",
      "endMs": "238071",
      "startTimeText": "3:55"
    },
    {
      "text": "प्री शूट कहो...",
      "startMs": "238071",
      "endMs": "238938",
      "startTimeText": "3:58"
    },
    {
      "text": "लेकिन फिर, उन्होंने देखा कि यह असली 'मैं' नहीं था,",
      "startMs": "239272",
      "endMs": "241407",
      "startTimeText": "3:59"
    },
    {
      "text": "और मैं उतना इमोशन नहीं कर सकती थी, जितना बिना मेकअप के करती थी।",
      "startMs": "241674",
      "endMs": "244544",
      "startTimeText": "4:01"
    },
    {
      "text": "इसलिए उन्होंने मुझे इसे उतारने के लिए कहा।",
      "startMs": "244544",
      "endMs": "245845",
      "startTimeText": "4:04"
    },
    {
      "text": "तो, अंत में यह हैमैं कहाँ हूँ और...",
      "startMs": "245845",
      "endMs": "248715",
      "startTimeText": "4:05"
    },
    {
      "text": "मैं व्यक्तिगत रूप से हूँबहुत खुश",
      "startMs": "249749",
      "endMs": "251484",
      "startTimeText": "4:09"
    },
    {
      "text": "कि मैं होता हूँयहाँ पर एक।",
      "startMs": "251484",
      "endMs": "253820",
      "startTimeText": "4:11"
    },
    {
      "text": "सचमुच...",
      "startMs": "253820",
      "endMs": "255188",
      "startTimeText": "4:13"
    },
    {
      "text": "आम तौर पर देखेंपूरी आबादी,",
      "startMs": "255188",
      "endMs": "257089",
      "startTimeText": "4:15"
    },
    {
      "text": "और हम सोचते हैं किकम लोग हैं",
      "startMs": "257089",
      "endMs": "258757",
      "startTimeText": "4:17"
    },
    {
      "text": "जो मजाक कर रहे हैंइस रंग के लोग,",
      "startMs": "258757",
      "endMs": "260627",
      "startTimeText": "4:18"
    },
    {
      "text": "लेकिन सच कहूं तो जब मैं स्कूल और कॉलेज में था,",
      "startMs": "260627",
      "endMs": "264063",
      "startTimeText": "4:20"
    },
    {
      "text": "मैं उन दोस्तों के साथ बड़ा हुआ हूं जो एक लड़की को देखते हैं",
      "startMs": "264063",
      "endMs": "266799",
      "startTimeText": "4:24"
    },
    {
      "text": "जिसका एक गहरा प्रेमी था, और उसने कहा,",
      "startMs": "266799",
      "endMs": "269002",
      "startTimeText": "4:26"
    },
    {
      "text": "\"अरे, आप वास्तव में बेहतर कर सकते हैं, आप उसकी लीग से बाहर हो गए हैं ...\"",
      "startMs": "269002",
      "endMs": "271304",
      "startTimeText": "4:29"
    },
    {
      "text": "और जब आप किसी लड़के को किसी ऐसी लड़की के साथ देखते हैं जो थोड़ी सी सांवली है,",
      "startMs": "271304",
      "endMs": "274307",
      "startTimeText": "4:31"
    },
    {
      "text": "आप अंत में कहते हैं,",
      "startMs": "274307",
      "endMs": "275108",
      "startTimeText": "4:34"
    },
    {
      "text": "\"मुझे लगता है कि कुछ और है, ये लोग।",
      "startMs": "275108",
      "endMs": "276643",
      "startTimeText": "4:35"
    },
    {
      "text": "क्या करता है, वह इस लड़की में क्या देखता है?\"",
      "startMs": "276643",
      "endMs": "278211",
      "startTimeText": "4:36"
    },
    {
      "text": "तो, हम अंत में ऐसी बातें कहते हैं, और यह कोई नहीं है,",
      "startMs": "278645",
      "endMs": "281347",
      "startTimeText": "4:38"
    },
    {
      "text": "कोई भी व्यक्ति जो वहां नहीं है, आपको बुरा महसूस कराने की कोशिश कर रहा है; यह सिर्फ हम हैं।",
      "startMs": "281347",
      "endMs": "284484",
      "startTimeText": "4:41"
    },
    {
      "text": "यह सिर्फ हम हैं।",
      "startMs": "284484",
      "endMs": "285485",
      "startTimeText": "4:44"
    },
    {
      "text": "हमने किसी समय, उस टिप्पणी को पारित किया होगा,",
      "startMs": "285485",
      "endMs": "288321",
      "startTimeText": "4:45"
    },
    {
      "text": "और अभी यह हमारे पास वापस आ रहा है। यह सिर्फ एक बूमरैंग है।",
      "startMs": "288321",
      "endMs": "291024",
      "startTimeText": "4:48"
    },
    {
      "text": "तो जब हम शुरू करते हैंसकारात्मक डालना",
      "startMs": "291024",
      "endMs": "294093",
      "startTimeText": "4:51"
    },
    {
      "text": "इशारा करने के बजाय हम दूसरों के बारे में कैसा महसूस करते हैं, इस बारे में विचार करते हैं",
      "startMs": "294093",
      "endMs": "297463",
      "startTimeText": "4:54"
    },
    {
      "text": "और दूसरी चीज़सोशल मीडिया है...",
      "startMs": "297463",
      "endMs": "299465",
      "startTimeText": "4:57"
    },
    {
      "text": "अभी तो सिर्फ इसलिए कि तुम्हारे पास यह गुमनामी का पर्दा है,",
      "startMs": "299766",
      "endMs": "302702",
      "startTimeText": "4:59"
    },
    {
      "text": "आप जो चाहते हैं उसे लिखना समाप्त करते हैं।",
      "startMs": "302702",
      "endMs": "304737",
      "startTimeText": "5:02"
    },
    {
      "text": "तुम बस कहते होकोई चीज़",
      "startMs": "304737",
      "endMs": "305772",
      "startTimeText": "5:04"
    },
    {
      "text": "जब तुम नहीं होबहुत अच्छे मूड में,",
      "startMs": "305772",
      "endMs": "307073",
      "startTimeText": "5:05"
    },
    {
      "text": "लेकिन समस्या यह है कि यह किसी और को प्रभावित करता है, कहीं और।",
      "startMs": "307073",
      "endMs": "309542",
      "startTimeText": "5:07"
    },
    {
      "text": "तो, आपके पास वास्तव में बदलाव लाने की शक्ति है।",
      "startMs": "310209",
      "endMs": "312745",
      "startTimeText": "5:10"
    },
    {
      "text": "चलो, मैंने अभी कहाआप कि मैंने असुरक्षित महसूस किया।",
      "startMs": "312745",
      "endMs": "314714",
      "startTimeText": "5:12"
    },
    {
      "text": "मैंने आप में से किसी को नहीं देखा।",
      "startMs": "314714",
      "endMs": "316082",
      "startTimeText": "5:14"
    },
    {
      "text": "लेकिन चलो, यहाँ से आप में से कुछ लोगों ने कहा होगा",
      "startMs": "316082",
      "endMs": "318051",
      "startTimeText": "5:16"
    },
    {
      "text": "मेरे बारे में कुछ मीठा, है ना? फिल्म कब रिलीज हुई?",
      "startMs": "318051",
      "endMs": "320286",
      "startTimeText": "5:18"
    },
    {
      "text": "इसलिए, मैंने उस पर विश्वास किया और मैंने इसे लिया, और इसी तरह मुझे अच्छा लगा।",
      "startMs": "320286",
      "endMs": "323556",
      "startTimeText": "5:20"
    },
    {
      "text": "तो, मुझे लगता है कि यह बस के बारे में है, यह कोई और नहीं है;",
      "startMs": "323556",
      "endMs": "325758",
      "startTimeText": "5:23"
    },
    {
      "text": "ऐसा नहीं है कि दुनिया हैआपको नीचे गिराने की कोशिश कर रहा है...",
      "startMs": "325758",
      "endMs": "327660",
      "startTimeText": "5:25"
    },
    {
      "text": "तुम वहाँ थे,और यह हम भी हो सकते हैं।",
      "startMs": "327660",
      "endMs": "330196",
      "startTimeText": "5:27"
    },
    {
      "text": "हम वहाँ एक पर थेबहुत भोली अवधि,",
      "startMs": "330196",
      "endMs": "331898",
      "startTimeText": "5:30"
    },
    {
      "text": "बहुत बुरा दौर",
      "startMs": "331898",
      "endMs": "333166",
      "startTimeText": "5:31"
    },
    {
      "text": "जहां हमने कहाकुछ गलत बातें,",
      "startMs": "333166",
      "endMs": "334634",
      "startTimeText": "5:33"
    },
    {
      "text": "लेकिन समय आ गया है कि हम बदलें।",
      "startMs": "334634",
      "endMs": "336002",
      "startTimeText": "5:34"
    },
    {
      "text": "हम जानते हैं कि हमारे लिए पाप करना संभव है,",
      "startMs": "336069",
      "endMs": "338738",
      "startTimeText": "5:36"
    },
    {
      "text": "लेकिन फिर यह महत्वपूर्ण हैहमारे लिए या पर विचार करने के लिए",
      "startMs": "338738",
      "endMs": "340707",
      "startTimeText": "5:38"
    },
    {
      "text": "या सम्मानदूसरों की भावनाएं",
      "startMs": "340707",
      "endMs": "342208",
      "startTimeText": "5:40"
    },
    {
      "text": "और उन्हें स्वीकार करेंवे किसके लिए हैं।",
      "startMs": "342208",
      "endMs": "344210",
      "startTimeText": "5:42"
    },
    {
      "text": "बस उनके चरित्र को देखो और बस प्यार में पड़ जाओ, बस।",
      "startMs": "344277",
      "endMs": "346946",
      "startTimeText": "5:44"
    },
    {
      "text": "मैं 27 साल का हूँ, औरमेरे सामने नहीं आया",
      "startMs": "347213",
      "endMs": "351984",
      "startTimeText": "5:47"
    },
    {
      "text": "एक महिला भी जिसे प्रताड़ित नहीं किया गया है।",
      "startMs": "351984",
      "endMs": "354787",
      "startTimeText": "5:51"
    },
    {
      "text": "और यह बहुत दुखद बात है, लेकिन सौभाग्य से,",
      "startMs": "354854",
      "endMs": "357990",
      "startTimeText": "5:54"
    },
    {
      "text": "हर कोई मुस्कुराता हुआ घूमता है और",
      "startMs": "357990",
      "endMs": "360259",
      "startTimeText": "5:57"
    },
    {
      "text": "मानो कुछ भी नहींयहां तक कि हुआ।",
      "startMs": "360259",
      "endMs": "361828",
      "startTimeText": "6:00"
    },
    {
      "text": "यह दर्शाता है कि हम बहुत अधिक मजबूत हैं",
      "startMs": "361994",
      "endMs": "363996",
      "startTimeText": "6:01"
    },
    {
      "text": "और हम इस शरीर को एक यंत्र समझते हैं।",
      "startMs": "363996",
      "endMs": "366566",
      "startTimeText": "6:03"
    },
    {
      "text": "लेकिन इसका मतलब यह नहीं है कि हमें नहीं करना चाहिए",
      "startMs": "366566",
      "endMs": "368735",
      "startTimeText": "6:06"
    },
    {
      "text": "किसी अन्य व्यक्ति के साथ अपना अनुभव साझा करें,",
      "startMs": "368735",
      "endMs": "370903",
      "startTimeText": "6:08"
    },
    {
      "text": "दो कारणों से।",
      "startMs": "370903",
      "endMs": "372038",
      "startTimeText": "6:10"
    },
    {
      "text": "एक यह है कि...",
      "startMs": "372038",
      "endMs": "374107",
      "startTimeText": "6:12"
    },
    {
      "text": "आप नहीं चाहतेअपराधी या अपराधी",
      "startMs": "374574",
      "endMs": "376409",
      "startTimeText": "6:14"
    },
    {
      "text": "किसी अन्य व्यक्ति को ऐसा करने के लिए।",
      "startMs": "376409",
      "endMs": "377944",
      "startTimeText": "6:16"
    },
    {
      "text": "और आप बस यही चाहते हैं कि आसपास के लोग इसके बारे में जागरूक हों।",
      "startMs": "377944",
      "endMs": "380780",
      "startTimeText": "6:17"
    },
    {
      "text": "और ज्यादातर समय, यह हमारी ओर से होता है,",
      "startMs": "381214",
      "endMs": "383616",
      "startTimeText": "6:21"
    },
    {
      "text": "हमारे रिश्तेदारों का कहना है,या कोई जिसे हम जानते हैं।",
      "startMs": "383616",
      "endMs": "386552",
      "startTimeText": "6:23"
    },
    {
      "text": "तो यह फिर से एक दुखद बात है।",
      "startMs": "386552",
      "endMs": "388821",
      "startTimeText": "6:26"
    },
    {
      "text": "और दूसरी बात, द्वाराइस अनुभव को साझा करना",
      "startMs": "388821",
      "endMs": "392024",
      "startTimeText": "6:28"
    },
    {
      "text": "किसी अन्य व्यक्ति के साथ जिस पर आप भरोसा करते हैं, या जिसे आप प्यार करते हैं,",
      "startMs": "392024",
      "endMs": "394360",
      "startTimeText": "6:32"
    },
    {
      "text": "माँ, पिताजी, दोस्त कहो,आपका जीवनसाथी, कोई भी...",
      "startMs": "394360",
      "endMs": "398398",
      "startTimeText": "6:34"
    },
    {
      "text": "आप अंत में थोड़ा मुक्त महसूस करते हैं, थोड़ा बेहतर,",
      "startMs": "398398",
      "endMs": "402468",
      "startTimeText": "6:38"
    },
    {
      "text": "मुझे आशा है, और उतना दर्दनाक नहीं जितना आपने किया।",
      "startMs": "402468",
      "endMs": "405338",
      "startTimeText": "6:42"
    },
    {
      "text": "लेकिन एक और बात थी, उह,",
      "startMs": "405338",
      "endMs": "407940",
      "startTimeText": "6:45"
    },
    {
      "text": "जिसका मैं उल्लेख करना चाहता था लेकिन एक और बात थी, उह,",
      "startMs": "407940",
      "endMs": "410209",
      "startTimeText": "6:47"
    },
    {
      "text": "सुरक्षा के अलावा, और उह, बेहतर सजा के लिए उह,",
      "startMs": "410476",
      "endMs": "415915",
      "startTimeText": "6:50"
    },
    {
      "text": "अपराधियों के लिए,मुझे लगता है कि यह हमारे लिए महत्वपूर्ण है...",
      "startMs": "415915",
      "endMs": "420820",
      "startTimeText": "6:55"
    },
    {
      "text": "हम बहुत खूबसूरत समय में हैं जहां हम समान वेतन पर ध्यान केंद्रित कर रहे हैं,",
      "startMs": "421053",
      "endMs": "424657",
      "startTimeText": "7:01"
    },
    {
      "text": "लैंगिक समानताऔर बहुत सी चीजें।",
      "startMs": "424657",
      "endMs": "426959",
      "startTimeText": "7:04"
    },
    {
      "text": "और मुझे लगता है कि यह महत्वपूर्ण है कि हम अनुशासन पर भी जोर दें।",
      "startMs": "427360",
      "endMs": "431297",
      "startTimeText": "7:07"
    },
    {
      "text": "यह, मुझे पता है कि यह एक हैशब्द जो हमने सीखा",
      "startMs": "431297",
      "endMs": "433166",
      "startTimeText": "7:11"
    },
    {
      "text": "स्कूल में याकॉलेज में,",
      "startMs": "433166",
      "endMs": "434434",
      "startTimeText": "7:13"
    },
    {
      "text": "लेकिन इमानदारी से,यह घर से शुरू होता है।",
      "startMs": "434434",
      "endMs": "436369",
      "startTimeText": "7:14"
    },
    {
      "text": "यह आसान है जहाँ आप सिर्फ अपने बच्चों को नोटिस करते हैं",
      "startMs": "438938",
      "endMs": "442275",
      "startTimeText": "7:18"
    },
    {
      "text": "समय की अवधि में व्यवहार करें और आप उन्हें ठीक करें।",
      "startMs": "442275",
      "endMs": "444210",
      "startTimeText": "7:22"
    },
    {
      "text": "आप समाज और पुलिस पर बोझ नहीं डाल सकते,",
      "startMs": "444210",
      "endMs": "447180",
      "startTimeText": "7:24"
    },
    {
      "text": "जिन संस्थानों में वे अनुशासन के लिए हैं, उन पर,",
      "startMs": "447180",
      "endMs": "450683",
      "startTimeText": "7:27"
    },
    {
      "text": "क्योंकि एक बार जब आप अपने बच्चों को सिखाते हैं कि कैसे होना है...",
      "startMs": "450683",
      "endMs": "454287",
      "startTimeText": "7:30"
    },
    {
      "text": "आप उन्हें विनम्रता सिखाते हैं, आप उन्हें मानवीय होना सिखाते हैं,",
      "startMs": "454287",
      "endMs": "457256",
      "startTimeText": "7:34"
    },
    {
      "text": "मुझे लगता है कि इससे दुनिया एक बेहतर जगह बनेगी।",
      "startMs": "457523",
      "endMs": "459692",
      "startTimeText": "7:37"
    },
    {
      "text": "मुझे लगता है कि आपको बेहतर उदाहरण बनना होगा ...",
      "startMs": "460059",
      "endMs": "462161",
      "startTimeText": "7:40"
    },
    {
      "text": "हम नहीं कर सकते...",
      "startMs": "462161",
      "endMs": "463062",
      "startTimeText": "7:42"
    },
    {
      "text": "क्योंकि जिन लोगों के बारे में हम बात करते हैं वे कुछ नहीं हैं",
      "startMs": "463062",
      "endMs": "465965",
      "startTimeText": "7:43"
    },
    {
      "text": "बेतरतीब लोग कहीं, धरती के किसी कोने में,",
      "startMs": "465965",
      "endMs": "468601",
      "startTimeText": "7:45"
    },
    {
      "text": "वे हमारे बीच हैं",
      "startMs": "468601",
      "endMs": "469702",
      "startTimeText": "7:48"
    },
    {
      "text": "और हम खुद,किसी समय,",
      "startMs": "469702",
      "endMs": "471637",
      "startTimeText": "7:49"
    },
    {
      "text": "एक और आत्मा के लिए बुरा किया गया है लेकिन फिर,",
      "startMs": "471637",
      "endMs": "475575",
      "startTimeText": "7:51"
    },
    {
      "text": "हम चले गएउस पर से...",
      "startMs": "475575",
      "endMs": "477143",
      "startTimeText": "7:55"
    },
    {
      "text": "यह किस वजह से हैहम सीख गए हैं...",
      "startMs": "477143",
      "endMs": "479111",
      "startTimeText": "7:57"
    },
    {
      "text": "हमें सिखाया गया हैहमारे बचपन से,",
      "startMs": "479111",
      "endMs": "480613",
      "startTimeText": "7:59"
    },
    {
      "text": "या जो हमने बचपन से देखा है।",
      "startMs": "480613",
      "endMs": "482849",
      "startTimeText": "8:00"
    },
    {
      "text": "आप अपने साथ कैसा व्यवहार करते हैंपत्नी और आपका बच्चा देखता है",
      "startMs": "482849",
      "endMs": "484951",
      "startTimeText": "8:02"
    },
    {
      "text": "आप अपनी पत्नी के साथ कैसा व्यवहार करते हैं, और ऐसा ही चल रहा है,",
      "startMs": "484951",
      "endMs": "487186",
      "startTimeText": "8:04"
    },
    {
      "text": "बच्चा ठीक सोचकर बड़ा होगा,",
      "startMs": "487186",
      "endMs": "488554",
      "startTimeText": "8:07"
    },
    {
      "text": "इस तरह हमएक महिला का इलाज...",
      "startMs": "488554",
      "endMs": "489489",
      "startTimeText": "8:08"
    },
    {
      "text": "आप कैसे...बच्चा कैसे...",
      "startMs": "489489",
      "endMs": "491457",
      "startTimeText": "8:09"
    },
    {
      "text": "के संपर्क में हैपर्यावरण",
      "startMs": "491757",
      "endMs": "492859",
      "startTimeText": "8:11"
    },
    {
      "text": "जहां वे एक महिला को आपत्तिजनक तरीके से देखते हैं",
      "startMs": "492859",
      "endMs": "494927",
      "startTimeText": "8:12"
    },
    {
      "text": "और इस तरह वे सोचते हैं कि यह सामान्य है ...",
      "startMs": "494927",
      "endMs": "497163",
      "startTimeText": "8:14"
    },
    {
      "text": "तो यह महत्वपूर्ण हैमुझे लगता है के बजाय",
      "startMs": "497163",
      "endMs": "499332",
      "startTimeText": "8:17"
    },
    {
      "text": "इस समस्या को हल करने के तरीकों की तलाश में,",
      "startMs": "499332",
      "endMs": "501767",
      "startTimeText": "8:19"
    },
    {
      "text": "इसे भीतर से शुरू करना होगा।हम में से अधिकांश भारत की महिलाएं हैं,",
      "startMs": "501767",
      "endMs": "504937",
      "startTimeText": "8:21"
    },
    {
      "text": "और उम, मुझे यकीन है कि हम सभी महान माता-पिता होंगे,",
      "startMs": "504937",
      "endMs": "508407",
      "startTimeText": "8:24"
    },
    {
      "text": "लेकिन हमारे लिए यह महत्वपूर्ण है कि हम न करें, मैथुन करें",
      "startMs": "508407",
      "endMs": "510977",
      "startTimeText": "8:28"
    },
    {
      "text": "और बस बच्चे पैदा करो... यह हमारी जिम्मेदारी है;",
      "startMs": "510977",
      "endMs": "513379",
      "startTimeText": "8:30"
    },
    {
      "text": "होने की उम्मीद करने के बजायएक बच्चा जो बनने जा रहा है",
      "startMs": "513379",
      "endMs": "517082",
      "startTimeText": "8:33"
    },
    {
      "text": "अगली बड़ी बात, उनके उद्योग में सर्वश्रेष्ठ होने जा रहा है,",
      "startMs": "517082",
      "endMs": "519485",
      "startTimeText": "8:37"
    },
    {
      "text": "या क्षेत्र या जो कुछ भी।",
      "startMs": "519485",
      "endMs": "520520",
      "startTimeText": "8:39"
    },
    {
      "text": "इसके लिए महत्वपूर्ण हैहमें सुनिश्चित करने के लिए",
      "startMs": "520520",
      "endMs": "522522",
      "startTimeText": "8:40"
    },
    {
      "text": "कि वे एक नहीं हैंदर्द या किसी तरह का",
      "startMs": "522522",
      "endMs": "528060",
      "startTimeText": "8:42"
    },
    {
      "text": "करने के लिए अशांतिखुद और समाज,",
      "startMs": "528060",
      "endMs": "529996",
      "startTimeText": "8:48"
    },
    {
      "text": "यह हमारी जिम्मेदारी है (आदि मन बध्याता)।",
      "startMs": "529996",
      "endMs": "532465",
      "startTimeText": "8:49"
    },
    {
      "text": "ऐसा नहीं है कि यह कुछ ऐसा है जो हमें करना है।",
      "startMs": "532465",
      "endMs": "534500",
      "startTimeText": "8:52"
    },
    {
      "text": "यह हमारा कर्तव्य है,क्योंकि तुम अंदर लाए हो",
      "startMs": "534500",
      "endMs": "536536",
      "startTimeText": "8:54"
    },
    {
      "text": "एक जा रहा हैइस दुनिया।",
      "startMs": "536536",
      "endMs": "538137",
      "startTimeText": "8:56"
    },
    {
      "text": "सुनिश्चित करें कि यह करता हैकोई नुकसान न पहुंचाएं,",
      "startMs": "538137",
      "endMs": "540740",
      "startTimeText": "8:58"
    },
    {
      "text": "और उस पर छोड़ दो।",
      "startMs": "540740",
      "endMs": "541974",
      "startTimeText": "9:00"
    },
    {
      "text": "यह ठीक है, आगे जो कुछ भी होता है वह भगवान पर निर्भर करता है और",
      "startMs": "541974",
      "endMs": "544110",
      "startTimeText": "9:01"
    },
    {
      "text": "अपनी प्रतिभा।",
      "startMs": "544110",
      "endMs": "545211",
      "startTimeText": "9:04"
    },
    {
      "text": "तो, बहुत-बहुत धन्यवादइस अवसर के लिए।",
      "startMs": "545211",
      "endMs": "547179",
      "startTimeText": "9:05"
    },
    {
      "text": "मुझे उम्मीद है कि मैं आप सभी से जुड़ सकता हूं,",
      "startMs": "547179",
      "endMs": "549015",
      "startTimeText": "9:07"
    },
    {
      "text": "एक स्तर पर जो मैं अपने अनुभव से कर सकता था।",
      "startMs": "549015",
      "endMs": "551417",
      "startTimeText": "9:09"
    },
    {
      "text": "और आपने जो कुछ भी किया है उसके लिए बहुत-बहुत धन्यवाद",
      "startMs": "551417",
      "endMs": "554120",
      "startTimeText": "9:11"
    },
    {
      "text": "बनाने के लिएहम सुरक्षित महसूस करते हैं।",
      "startMs": "554120",
      "endMs": "555087",
      "startTimeText": "9:14"
    },
    {
      "text": "शुक्रियाफिर से इतना।",
      "startMs": "555087",
      "endMs": "556222",
      "startTimeText": "9:15"
    }
  ],
  "quality_status": "timestamped_candidate",
  "review_status": "not_contextually_reviewed",
  "translation_status": "not_independently_verified"
}
