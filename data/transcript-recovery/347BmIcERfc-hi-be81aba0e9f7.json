      "startMs": "277300",
      "endMs": "281313",
      "startTimeText": "4:37"
    },
    {
      "text": "और...",
      "startMs": "281590",
      "endMs": "282663",
      "startTimeText": "4:41"
    },
    {
      "text": "और उन्हें और उनके भविष्य को गंभीरता से।",
      "startMs": "282743",
      "endMs": "286160",
      "startTimeText": "4:42"
    },
    {
      "text": "और शायद खड़े होने और इसके बारे में कुछ करने के लिए,",
      "startMs": "286420",
      "endMs": "289319",
      "startTimeText": "4:46"
    },
    {
      "text": "केवल खड़े होकर कहने के बजाय,",
      "startMs": "289943",
      "endMs": "291760",
      "startTimeText": "4:49"
    },
    {
      "text": "ओह, तुम्हें पता है, मैं इसके बारे में कुछ नहीं कर सकता।",
      "startMs": "291830",
      "endMs": "294819",
      "startTimeText": "4:51"
    },
    {
      "text": "हाँ आप कर सकते हैं।",
      "startMs": "294980",
      "endMs": "295950",
      "startTimeText": "4:54"
    },
    {
      "text": "हममें से हर कोई खड़ा हो सकता है",
      "startMs": "296350",
      "endMs": "298220",
      "startTimeText": "4:56"
    },
    {
      "text": "और सामाजिक जिम्मेदारी का वह छोटा सा हिस्सा लें",
      "startMs": "298220",
      "endMs": "300500",
      "startTimeText": "4:58"
    },
    {
      "text": "और खड़े हो जाओ और कहो, ठीक है,",
      "startMs": "300500",
      "endMs": "301700",
      "startTimeText": "5:00"
    },
    {
      "text": "मैं दुनिया का सबसे अमीर आदमी नहीं हो सकता,",
      "startMs": "301980",
      "endMs": "304430",
      "startTimeText": "5:01"
    },
    {
      "text": "या मैं सबसे ज्यादा नहीं हो सकता,",
      "startMs": "304940",
      "endMs": "306680",
      "startTimeText": "5:04"
    },
    {
      "text": "आपको पता है,",
      "startMs": "309180",
      "endMs": "309700",
      "startTimeText": "5:09"
    },
    {
      "text": "दुनिया का सबसे प्रभावशाली आदमी,",
      "startMs": "310140",
      "endMs": "312099",
      "startTimeText": "5:10"
    },
    {
      "text": "लेकिन कम से कम मैं अपने परिवेश को प्रभावित कर सकता हूं",
      "startMs": "312540",
      "endMs": "315740",
      "startTimeText": "5:12"
    },
    {
      "text": "और मैं अपने आसपास के लोगों को बेहतर आदतों के लिए प्रभावित कर सकता हूँ।",
      "startMs": "315920",
      "endMs": "319600",
      "startTimeText": "5:15"
    },
    {
      "text": "और वास्तव में, यह ईमानदारी से सरल है।",
      "startMs": "320240",
      "endMs": "322280",
      "startTimeText": "5:20"
    },
    {
      "text": "यह उन चीजों में से एक है जो मैंने घर पर की थी,",
      "startMs": "322320",
      "endMs": "325350",
      "startTimeText": "5:22"
    },
    {
      "text": "सिर्फ तुम्हें देने के लिए...",
      "startMs": "325590",
      "endMs": "326530",
      "startTimeText": "5:25"
    },
    {
      "text": "सिर्फ आपको एक उदाहरण देने के लिए।",
      "startMs": "326620",
      "endMs": "327780",
      "startTimeText": "5:26"
    },
    {
      "text": "इसलिए हमारे पास देश भर से नौकर हैं",
      "startMs": "328189",
      "endMs": "330540",
      "startTimeText": "5:28"
    },
    {
      "text": "जो आते हैं और हमारे साथ रहते हैं, जाहिर है।",
      "startMs": "330600",
      "endMs": "332620",
      "startTimeText": "5:30"
    },
    {
      "text": "तो यह उन चीजों में से एक थी जिसके बारे में हमें उन्हें शिक्षित करना था कि कैसे",
      "startMs": "333100",
      "endMs": "337080",
      "startTimeText": "5:33"
    },
    {
      "text": "साफ पानी से फर्क पड़ता है, साफ शौचालय से उन्हें कितना फर्क पड़ता है।",
      "startMs": "337140",
      "endMs": "342879",
      "startTimeText": "5:37"
    },
    {
      "text": "जब वे हमारे साथ रह रहे होते हैं, तब उन्हें साफ पानी की अहमियत का एहसास होता है,",
      "startMs": "342900",
      "endMs": "347050",
      "startTimeText": "5:42"
    },
    {
      "text": "साफ हाथ, क्योंकि मैं चिल्लाती हूं और चिल्लाती हूं कि उन्हें अपना हाथ धोना है",
      "startMs": "347209",
      "endMs": "350410",
      "startTimeText": "5:47"
    },
    {
      "text": "मेरी सब्जियां धोने से पहले हाथ।",
      "startMs": "350410",
      "endMs": "351850",
      "startTimeText": "5:50"
    },
    {
      "text": "और स्वच्छ शौचालय, और इसके अंत में, वे स्वस्थ हैं।",
      "startMs": "353610",
      "endMs": "358030",
      "startTimeText": "5:53"
    },
    {
      "text": "इसी वजह से वे बिरले ही बीमार पड़ते हैं।",
      "startMs": "358289",
      "endMs": "361119",
      "startTimeText": "5:58"
    },
    {
      "text": "और वे वापस जाने वाले हैं,",
      "startMs": "361140",
      "endMs": "362360",
      "startTimeText": "6:01"
    },
    {
      "text": "और वे अपने गाँव वापस जाने वाले हैं",
      "startMs": "362760",
      "endMs": "364560",
      "startTimeText": "6:02"
    },
    {
      "text": "और उनके परिवारों को,",
      "startMs": "364560",
      "endMs": "365729",
      "startTimeText": "6:04"
    },
    {
      "text": "और वे इन्हीं आदतों के साथ वापस जाने वाले हैं।",
      "startMs": "365759",
      "endMs": "367850",
      "startTimeText": "6:05"
    },
    {
      "text": "तो यह सिर्फ एक छोटा सा बदलाव है।",
      "startMs": "368100",
      "endMs": "371120",
      "startTimeText": "6:08"
    },
    {
      "text": "यह सिर्फ एक छोटा सा विचार प्रक्रिया परिवर्तन है",
      "startMs": "371200",
      "endMs": "373550",
      "startTimeText": "6:11"
    },
    {
      "text": "कि हमने प्रभावित किया है, कि मैंने प्रभावित किया है।",
      "startMs": "373550",
      "endMs": "375510",
      "startTimeText": "6:13"
    },
    {
      "text": "मुझे यकीन है कि बहुत से लोग प्रभावित हुए हैं",
      "startMs": "376100",
      "endMs": "378270",
      "startTimeText": "6:16"
    },
    {
      "text": "उनके घरों और जीवन में।",
      "startMs": "378270",
      "endMs": "380820",
      "startTimeText": "6:18"
    },
    {
      "text": "और...",
      "startMs": "381499",
      "endMs": "382626",
      "startTimeText": "6:21"
    },
    {
      "text": "मुझे लगता है कि...",
      "startMs": "382959",
      "endMs": "383640",
      "startTimeText": "6:22"
    },
    {
      "text": "यहीं पर हमें प्लेइंग बिलियन का विचार भी आया।",
      "startMs": "383700",
      "endMs": "387860",
      "startTimeText": "6:23"
    },
    {
      "text": "और...",
      "startMs": "388460",
      "endMs": "389584",
      "startTimeText": "6:28"
    },
    {
      "text": "मेरे पास वास्तव में इस तथ्य के अलावा और कुछ नहीं कहना है कि...",
      "startMs": "390428",
      "endMs": "395273",
      "startTimeText": "6:30"
    },
    {
      "text": "हम मानते हैं कि स्वच्छता ईश्वरत्व के बगल में है।",
      "startMs": "397170",
      "endMs": "400367",
      "startTimeText": "6:37"
    },
    {
      "text": "और...",
      "startMs": "400689",
      "endMs": "401576",
      "startTimeText": "6:40"
    },
    {
      "text": "यदि ईश्वरत्व, यदि हम सब प्रेरणा दें...",
      "startMs": "402339",
      "endMs": "405526",
      "startTimeText": "6:42"
    },
    {
      "text": "भगवत्प्राप्ति की आकांक्षा करो,",
      "startMs": "405533",
      "endMs": "407180",
      "startTimeText": "6:45"
    },
    {
      "text": "मुझे लगता है कि इस दिशा में पहला कदम है",
      "startMs": "407220",
      "endMs": "409300",
      "startTimeText": "6:47"
    },
    {
      "text": "एक स्वच्छ, बेहतर भारत बनाना होगा।",
      "startMs": "409540",
      "endMs": "411920",
      "startTimeText": "6:49"
    },
    {
      "text": "शुक्रिया।",
      "startMs": "411999",
      "endMs": "412360",
      "startTimeText": "6:51"
    },
    {
      "text": "तो देवियों और सज्जनों, हमारी प्रशंसा के प्रतीक के रूप में,",
      "startMs": "414900",
      "endMs": "417930",
      "startTimeText": "6:54"
    },
    {
      "text": "एचयूएल प्रायोजित करेगा",
      "startMs": "418300",
      "endMs": "420360",
      "startTimeText": "6:58"
    },
    {
      "text": "एक वर्ष के लिए स्वच्छ आदत, स्वच्छ भारत स्वच्छता जांच",
      "startMs": "420369",
      "endMs": "424550",
      "startTimeText": "7:00"
    },
    {
      "text": "इन बच्चों और उनके परिवारों।",
      "startMs": "424550",
      "endMs": "426390",
      "startTimeText": "7:04"
    },
    {
      "text": "और ठीक है, अगर हमने उन्हें तीन आदतें सिखाई हैं",
      "startMs": "426690",
      "endMs": "430800",
      "startTimeText": "7:06"
    },
    {
      "text": "और उन्हें पालन करने में मदद करने के लिए उन्हें उत्पाद दिए",
      "startMs": "430800",
      "endMs": "433150",
      "startTimeText": "7:10"
    },
    {
      "text": "ये तीन आदतें",
      "startMs": "433150",
      "endMs": "433950",
      "startTimeText": "7:13"
    },
    {
      "text": "मुझे यकीन है कि वे हर दिन खेल सकेंगे।",
      "startMs": "434170",
      "endMs": "438130",
      "startTimeText": "7:14"
    },
    {
      "text": "तो यहां उनके लिए कुछ क्रिकेटिंग गियर भी हैं।",
      "startMs": "438199",
      "endMs": "440390",
      "startTimeText": "7:18"
    },
    {
      "text": "ठीक है।",
      "startMs": "441260",
      "endMs": "441650",
      "startTimeText": "7:21"
    },
    {
      "text": "और मुझे यकीन है कि बच्चे इस खास पल और इस अद्भुत पल को कभी नहीं भूलेंगे",
      "startMs": "441650",
      "endMs": "446130",
      "startTimeText": "7:21"
    },
    {
      "text": "सराहना करें कि आपने उन्हें दिया है।",
      "startMs": "446130",
      "endMs": "447150",
      "startTimeText": "7:26"
    },
    {
      "text": "इसलिए अब मैं आप सभी को पसंद करूंगा जो आपने ले लिया है",
      "startMs": "447150",
      "endMs": "449200",
      "startTimeText": "7:27"
    },
    {
      "text": "उनके साथ आपकी तस्वीर,",
      "startMs": "449200",
      "endMs": "450240",
      "startTimeText": "7:29"
    },
    {
      "text": "और उनके पास अपने साथ वापस ले जाने के लिए बेहतरीन यादें हैं।",
      "startMs": "450909",
      "endMs": "452820",
      "startTimeText": "7:30"
    },
    {
      "text": "तो यहाँ चेक है।",
      "startMs": "452820",
      "endMs": "453675",
      "startTimeText": "7:32"
    }
  ],
