    },
    {
      "text": "और मेरा मानना ​​है कि मानवता को फलने-फूलने की जरूरत है।",
      "startMs": "243676",
      "endMs": "246079",
      "startTimeText": "4:03"
    },
    {
      "text": "ये तीन चीजें समय हैं,",
      "startMs": "246079",
      "endMs": "248248",
      "startTimeText": "4:06"
    },
    {
      "text": "पर्याप्त प्रयास और ईश्वरीय कृपा।",
      "startMs": "248481",
      "endMs": "250917",
      "startTimeText": "4:08"
    },
    {
      "text": "हमें इन तीन चीजों को नए सिरे से लगाने की जरूरत है,",
      "startMs": "250917",
      "endMs": "253953",
      "startTimeText": "4:10"
    },
    {
      "text": "पूरे और पूरे दिल से,",
      "startMs": "254487",
      "endMs": "256556",
      "startTimeText": "4:14"
    },
    {
      "text": "एक देश के रूप में चंगा और प्रेरित,",
      "startMs": "256756",
      "endMs": "259592",
      "startTimeText": "4:16"
    },
    {
      "text": "बीज के जंगल के रूप में जो उत्परिवर्तित हो गए हैं,",
      "startMs": "260026",
      "endMs": "262829",
      "startTimeText": "4:20"
    },
    {
      "text": "नए और सरल तरीकों से पोषित",
      "startMs": "262996",
      "endMs": "265498",
      "startTimeText": "4:22"
    },
    {
      "text": "पानी और दैवीय हस्तक्षेप की,",
      "startMs": "265498",
      "endMs": "267767",
      "startTimeText": "4:25"
    },
    {
      "text": "जो महान के माध्यम से हम सभी से बात करता है",
      "startMs": "267767",
      "endMs": "270136",
      "startTimeText": "4:27"
    },
    {
      "text": "करुणा की आवाज के साथ प्रकृति माँ।",
      "startMs": "270136",
      "endMs": "273306",
      "startTimeText": "4:30"
    },
    {
      "text": "हम समय और पर्याप्त प्रयास को नियंत्रित कर सकते हैं।",
      "startMs": "273873",
      "endMs": "277277",
      "startTimeText": "4:33"
    },
    {
      "text": "हम ईश्वरीय कृपा को नियंत्रित नहीं कर सकते,",
      "startMs": "277510",
      "endMs": "279879",
      "startTimeText": "4:37"
    },
    {
      "text": "लेकिन मेरा मानना ​​है कि ईश्वरीय कृपा ही विश्वास है",
      "startMs": "280013",
      "endMs": "282915",
      "startTimeText": "4:40"
    },
    {
      "text": "हम एक दूसरे में जगह चुन सकते हैं,",
      "startMs": "283616",
      "endMs": "285551",
      "startTimeText": "4:43"
    },
    {
      "text": "प्यार से और प्रभावी ढंग से समृद्ध होने के लिए।",
      "startMs": "286085",
      "endMs": "288354",
      "startTimeText": "4:46"
    },
    {
      "text": "मुझे विश्वास है कि आप सुंदर बीज",
      "startMs": "288621",
      "endMs": "290490",
      "startTimeText": "4:48"
    },
    {
      "text": "शानदार तोहफा दिया है।",
      "startMs": "290490",
      "endMs": "292759",
      "startTimeText": "4:50"
    },
    {
      "text": "इस शक्तिशाली क्षण में प्रतिबिंबित करने का अवसर,",
      "startMs": "293926",
      "endMs": "296896",
      "startTimeText": "4:53"
    },
    {
      "text": "आपकी नैतिकता, आपके सिद्धांतों और आपके मूल्यों पर,",
      "startMs": "297063",
      "endMs": "299399",
      "startTimeText": "4:57"
    },
    {
      "text": "और वे आपका मार्गदर्शन कैसे करेंगे",
      "startMs": "299399",
      "endMs": "300566",
      "startTimeText": "4:59"
    },
    {
      "text": "जीवन के माध्यम से यह खुद को प्रस्तुत करता है।",
      "startMs": "300566",
      "endMs": "302502",
      "startTimeText": "5:00"
    },
    {
      "text": "और जैसा कि आप सोचते हैं कि यह आपको कहाँ ले जाएगा,",
      "startMs": "302502",
      "endMs": "305271",
      "startTimeText": "5:02"
    },
    {
      "text": "आपकी नैतिकता, सिद्धांत और मूल्य,",
      "startMs": "306406",
      "endMs": "308808",
      "startTimeText": "5:06"
    },
    {
      "text": "मुझे अब पूरा विश्वास है,",
      "startMs": "308808",
      "endMs": "310276",
      "startTimeText": "5:08"
    },
    {
      "text": "आपके प्रति ईमानदार और प्रामाणिक होना चाहिए।",
      "startMs": "310610",
      "endMs": "314013",
      "startTimeText": "5:10"
    },
    {
      "text": "आपके सिद्धांत आपके दिल से आने चाहिए।",
      "startMs": "314714",
      "endMs": "316849",
      "startTimeText": "5:14"
    },
    {
      "text": "आपके मूल्य आपके मस्तिष्क से आने चाहिए।",
      "startMs": "317417",
      "endMs": "319752",
      "startTimeText": "5:17"
    },
    {
      "text": "आपकी नैतिकता संपूर्ण आप से प्राप्त होनी चाहिए,",
      "startMs": "320219",
      "endMs": "323623",
      "startTimeText": "5:20"
    },
    {
      "text": "कि आप मानवता के लिए प्यार से योगदान करते हैं,",
      "startMs": "323623",
      "endMs": "326292",
      "startTimeText": "5:23"
    },
    {
      "text": "वैश्विक समुदाय के लिए आपकी सेवा",
      "startMs": "327126",
      "endMs": "329462",
      "startTimeText": "5:27"
    },
    {
      "text": "दयालुता होगी जो कस्टम मेड है",
      "startMs": "329762",
      "endMs": "332198",
      "startTimeText": "5:29"
    },
    {
      "text": "आपके द्वारा दुनिया के लिए।",
      "startMs": "332198",
      "endMs": "334300",
      "startTimeText": "5:32"
    },
    {
      "text": "अपने मूल भाषण में, मैं प्रश्न पूछता हूं:",
      "startMs": "335401",
      "endMs": "337537",
      "startTimeText": "5:35"
    },
    {
      "text": "हर समय दयालु बने रहने के लिए क्या करना होगा?",
      "startMs": "337537",
      "endMs": "339439",
      "startTimeText": "5:37"
    },
    {
      "text": "शायद यह सवाल आज भी प्रासंगिक है।",
      "startMs": "340273",
      "endMs": "342308",
      "startTimeText": "5:40"
    },
    {
      "text": "मैं इस उत्तर को कुछ कहकर फ्रेम करना चाहता हूं",
      "startMs": "342308",
      "endMs": "345011",
      "startTimeText": "5:42"
    },
    {
      "text": "एक अवसर पर स्पष्ट प्रतीत होता है जहां",
      "startMs": "345011",
      "endMs": "347013",
      "startTimeText": "5:45"
    },
    {
      "text": "आपने पहले ही खुद को स्मार्ट, सक्षम इंसान साबित कर दिया है।",
      "startMs": "347013",
      "endMs": "350717",
      "startTimeText": "5:47"
    },
    {
      "text": "लोग कठिन काम कर सकते हैं।",
      "startMs": "351017",
      "endMs": "352819",
      "startTimeText": "5:51"
    },
    {
      "text": "आप कठिन काम कर सकते हैं।",
      "startMs": "353119",
      "endMs": "354721",
      "startTimeText": "5:53"
    },
    {
      "text": "आप जंगल को चीर सकते हैं और फिर से लगा सकते हैं",
      "startMs": "354987",
      "endMs": "357657",
      "startTimeText": "5:54"
    },
    {
      "text": "केवल आपके पास एक दृष्टि होने के लिए।",
      "startMs": "357657",
      "endMs": "359592",
      "startTimeText": "5:57"
    },
    {
      "text": "कभी-कभी, दयालु होना कठिन होता है।",
      "startMs": "360226",
      "endMs": "362061",
      "startTimeText": "6:00"
    },
    {
      "text": "मुझे यकीन है कि आप कुछ निर्दयी सहपाठियों के बारे में सोच सकते हैं,",
      "startMs": "362695",
      "endMs": "365465",
      "startTimeText": "6:02"
    },
    {
      "text": "दोस्त, परिवार के सदस्य, अजनबी, लोग,",
      "startMs": "365465",
      "endMs": "368468",
      "startTimeText": "6:05"
    },
    {
      "text": "आपके विद्यालय के शिक्षक",
      "startMs": "368468",
      "endMs": "369802",
      "startTimeText": "6:08"
    },
    {
      "text": "या यहां तक ​​कि कई बार आपने निर्दयी व्यवहार किया है।",
      "startMs": "369802",
      "endMs": "372372",
      "startTimeText": "6:09"
    },
    {
      "text": "भले ही आपने देखा हो",
      "startMs": "373039",
      "endMs": "374307",
      "startTimeText": "6:13"
    },
    {
      "text": "दयालुता की कमी, इसके अलावा,",
      "startMs": "374307",
      "endMs": "376809",
      "startTimeText": "6:14"
    },
    {
      "text": "जो क्षमता का नरभक्षण नहीं करता है",
      "startMs": "376809",
      "endMs": "378945",
      "startTimeText": "6:16"
    },
    {
      "text": "लोगों को कठिन काम करने के लिए। तो, दयालु होने के बाद से",
      "startMs": "378945",
      "endMs": "381981",
      "startTimeText": "6:18"
    },
    {
      "text": "मुश्किल काम करने का मतलब हो सकता है,",
      "startMs": "382749",
      "endMs": "384450",
      "startTimeText": "6:22"
    },
    {
      "text": "कभी-कभी, दया के अभाव में भी,",
      "startMs": "384717",
      "endMs": "387420",
      "startTimeText": "6:24"
    },
    {
      "text": "लोग अभी भी कठिन काम कर सकते हैं और दयालु हो सकते हैं।",
      "startMs": "387653",
      "endMs": "390289",
      "startTimeText": "6:27"
    },
    {
      "text": "मैं आपको दयालु होने के लिए प्रोत्साहित करता हूं।",
      "startMs": "391157",
      "endMs": "392892",
      "startTimeText": "6:31"
    },
    {
      "text": "मैं यह उस उदाहरण को स्थापित करने के लिए करता हूं जो मैं चाहता हूं,",
      "startMs": "393226",
      "endMs": "395595",
      "startTimeText": "6:33"
    },
    {
      "text": "मेरे पास जबरदस्त विशेषाधिकार के साथ",
      "startMs": "395595",
      "endMs": "397630",
      "startTimeText": "6:35"
    },
    {
      "text": "आज आपको यह आरंभिक भाषण देते हुए।",
      "startMs": "397630",
      "endMs": "400299",
      "startTimeText": "6:37"
    },
    {
      "text": "जब मैं दयालुता के बारे में उस बिट को शामिल करता हूं,",
      "startMs": "400767",
      "endMs": "403803",
      "startTimeText": "6:40"
    },
    {
      "text": "हम दोनों के बीच इस पल के दौरान मैं यह सुनिश्चित कर रहा हूं,",
      "startMs": "404771",
      "endMs": "407840",
      "startTimeText": "6:44"
    },
    {
      "text": "कि मैं अपनी नैतिकता, मूल्यों से सुसज्जित हूं,",
      "startMs": "407840",
      "endMs": "409842",
      "startTimeText": "6:47"
    },
    {
      "text": "और एक बहुत ही महत्वपूर्ण विषय के लिए सिद्धांत।",
      "startMs": "409842",
      "endMs": "412211",
      "startTimeText": "6:49"
    },
    {
      "text": "अब हम क्या करें?",
      "startMs": "413312",
      "endMs": "414447",
      "startTimeText": "6:53"
    },
    {
      "text": "दयालुता का मेरा उत्तर सरल है।",
      "startMs": "416182",
      "endMs": "419652",
      "startTimeText": "6:56"
    },
    {
      "text": "लेकिन यह मेरा है।",
      "startMs": "421053",
      "endMs": "421788",
      "startTimeText": "7:01"
    },
    {
      "text": "क्योंकि अभी, सामान्य से अधिक,",
      "startMs": "422655",
      "endMs": "424424",
      "startTimeText": "7:02"
    },
    {
      "text": "हम एक दूसरे से बात करने की कोशिश कर रहे हैं।",
      "startMs": "424891",
      "endMs": "426492",
      "startTimeText": "7:04"
    },
    {
      "text": "चल बात करते है।",
      "startMs": "427527",
      "endMs": "428261",
      "startTimeText": "7:07"
    },
    {
      "text": "लेकिन जैसा आपने अपनी कक्षाओं में किया था",
      "startMs": "428895",
      "endMs": "430530",
      "startTimeText": "7:08"
    },
    {
      "text": "लगभग हर दिन, आइए सुनते भी हैं।",
      "startMs": "430530",
      "endMs": "433332",
      "startTimeText": "7:10"
    },
    {
      "text": "अगर हम नहीं सुनते हैं, तो हम नहीं सीखते हैं।",
      "startMs": "433699",
      "endMs": "435968",
      "startTimeText": "7:13"
    },
    {
      "text": "2020 की कक्षा के लिए बधाई।",
      "startMs": "436936",
      "endMs": "440173",
      "startTimeText": "7:16"
    },
    {
      "text": "मैं तुम्हारे जंगल को देखने के लिए और इंतजार नहीं कर सकता।",
      "startMs": "441040",
      "endMs": "444043",
      "startTimeText": "7:21"
    }
  ],
