  "transcript": [
    {
      "text": "मैं अधिक महिलाओं से बात करने का आग्रह करूंगा।",
      "startMs": "800",
      "endMs": "3169",
      "startTimeText": "0:00"
    },
    {
      "text": "हीन या कमजोर महसूस करना ठीक नहीं है",
      "startMs": "4170",
      "endMs": "7307",
      "startTimeText": "0:04"
    },
    {
      "text": "क्योंकि हम कमजोर सेक्स नहीं हैं",
      "startMs": "7874",
      "endMs": "9709",
      "startTimeText": "0:07"
    },
    {
      "text": "कल्पना के किसी भी खिंचाव से।",
      "startMs": "9709",
      "endMs": "11911",
      "startTimeText": "0:09"
    },
    {
      "text": "हम अधिक भावुक हो सकते हैं,",
      "startMs": "12078",
      "endMs": "13613",
      "startTimeText": "0:12"
    },
    {
      "text": "लेकिन यही हमें देखभाल करने वाली और मां बनाती है।",
      "startMs": "13713",
      "endMs": "16549",
      "startTimeText": "0:13"
    },
    {
      "text": "एक ऐसी दुनिया के रूप में बनें जिसे हम 2030 तक हासिल करने का प्रयास करते हैं।",
      "startMs": "18451",
      "endMs": "21421",
      "startTimeText": "0:18"
    },
    {
      "text": "मैं भाग्यशाली था कि मुझे एक छोटी सी भूमिका निभाने का मौका मिला",
      "startMs": "22088",
      "endMs": "24324",
      "startTimeText": "0:22"
    },
    {
      "text": "भारत में घोषणा में",
      "startMs": "24324",
      "endMs": "25859",
      "startTimeText": "0:24"
    },
    {
      "text": "इसके लिए अक्षय कुमार के साथ,",
      "startMs": "26559",
      "endMs": "28328",
      "startTimeText": "0:26"
    },
    {
      "text": "एआर रहमान और श्रीमती टीना अंबानी।",
      "startMs": "28328",
      "endMs": "30530",
      "startTimeText": "0:28"
    },
    {
      "text": "यह एक महत्वाकांक्षी प्रस्ताव है",
      "startMs": "31631",
      "endMs": "33033",
      "startTimeText": "0:31"
    },
    {
      "text": "और 14 वर्षों में हासिल करना कठिन है,",
      "startMs": "33033",
      "endMs": "35502",
      "startTimeText": "0:33"
    },
    {
      "text": "लेकिन मुझे विश्वास है कि हम इसे हासिल कर सकते हैं",
      "startMs": "36469",
      "endMs": "38571",
      "startTimeText": "0:36"
    },
    {
      "text": "अगर हम सब मिलकर ईमानदारी से प्रयास करें।",
      "startMs": "38571",
      "endMs": "40607",
      "startTimeText": "0:38"
    },
    {
      "text": "मुझे यकीन है कि आप में से बहुत से लोग जानते हैं",
      "startMs": "42342",
      "endMs": "44044",
      "startTimeText": "0:42"
    },
    {
      "text": "कि भारत में राज्य की मुखिया के रूप में एक महिला थी",
      "startMs": "44144",
      "endMs": "46980",
      "startTimeText": "0:44"
    },
    {
      "text": "यूनाइटेड किंगडम से पहले,",
      "startMs": "47313",
      "endMs": "49249",
      "startTimeText": "0:47"
    },
    {
      "text": "एक विशेषता संयुक्त राज्य अमेरिका",
