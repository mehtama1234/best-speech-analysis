      "text": "हिंसा के सामने खामोश",
      "startMs": "157957",
      "endMs": "159893",
      "startTimeText": "2:37"
    },
    {
      "text": "क्योंकि वे सामाजिक मानदंडों का सामना करने से डरते हैं",
      "startMs": "160360",
      "endMs": "164264",
      "startTimeText": "2:40"
    },
    {
      "text": "और उंगलियों को अपनी दिशा में इंगित किया है।",
      "startMs": "164264",
      "endMs": "166699",
      "startTimeText": "2:44"
    },
    {
      "text": "खासकर जब हमारे समाज के अधिकांश लोग",
      "startMs": "168501",
      "endMs": "171471",
      "startTimeText": "2:48"
    },
    {
      "text": "वैवाहिक बलात्कार को अपराध के रूप में मान्यता देने में विफल।",
      "startMs": "171871",
      "endMs": "174607",
      "startTimeText": "2:51"
    },
    {
      "text": "मैं अधिक महिलाओं से बात करने का आग्रह करूंगा।",
      "startMs": "176176",
      "endMs": "178545",
      "startTimeText": "2:56"
    },
    {
      "text": "हीन या कमजोर महसूस करना ठीक नहीं है",
      "startMs": "179546",
      "endMs": "182682",
      "startTimeText": "2:59"
    },
    {
      "text": "क्योंकि हम कमजोर सेक्स नहीं हैं",
      "startMs": "184417",
      "endMs": "186252",
      "startTimeText": "3:04"
    },
    {
      "text": "कल्पना के किसी भी खिंचाव से।",
      "startMs": "186252",
      "endMs": "188454",
      "startTimeText": "3:06"
    },
    {
      "text": "हम अधिक भावुक हो सकते हैं,",
