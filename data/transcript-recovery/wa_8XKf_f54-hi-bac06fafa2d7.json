      "text": "कृपया अपना सिर अपने कंधों पर रखें।",
      "startMs": "511698",
      "endMs": "513598",
      "startTimeText": "8:31"
    },
    {
      "text": "ज्यादा ऊंचा मत उड़ो।",
      "startMs": "513598",
      "endMs": "514468",
      "startTimeText": "8:33"
    },
    {
      "text": "और मैं ऐसा था, वे क्या कह रहे हैं?",
      "startMs": "514468",
      "endMs": "515898",
      "startTimeText": "8:34"
    },
    {
      "text": "वे ऐसा क्यों कह रहे हैं?",
      "startMs": "515898",
      "endMs": "516678",
      "startTimeText": "8:35"
    },
    {
      "text": "और तब मुझे एहसास हुआ कि, ठीक है, चीज़ें बदल सकती हैं।",
      "startMs": "517138",
      "endMs": "520058",
      "startTimeText": "8:37"
    },
    {
      "text": "आपकी फिल्में अच्छा नहीं कर सकतीं।",
      "startMs": "520058",
      "endMs": "521408",
      "startTimeText": "8:40"
    },
    {
      "text": "आप अच्छा नहीं कर सकते।",
      "startMs": "521408",
      "endMs": "522488",
      "startTimeText": "8:41"
    },
    {
      "text": "और अचानक उसके बाद सब कुछ बदल गया।",
