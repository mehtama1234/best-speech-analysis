      "endMs": "284682",
      "startTimeText": "4:41"
    },
    {
      "text": "हमें किसी का इंतजार नहीं करना है।",
      "startMs": "285072",
      "endMs": "286712",
      "startTimeText": "4:45"
    },
    {
      "text": "आप जो प्रदान कर सकते हैं उसे कभी कम मत समझिए",
      "startMs": "287932",
      "endMs": "290652",
      "startTimeText": "4:47"
    },
    {
      "text": "छोटा कदम उठाकर",
      "startMs": "290902",
      "endMs": "292532",
      "startTimeText": "4:50"
    },
    {
      "text": "जब आप अपने दाँत ब्रश करते हैं तो पानी बंद करना",
      "startMs": "292802",
      "endMs": "295342",
      "startTimeText": "4:52"
    },
    {
      "text": "या स्नान करने में थोड़ा कम समय व्यतीत करना।",
      "startMs": "295832",
      "endMs": "298502",
      "startTimeText": "4:55"
    },
    {
      "text": "यह हमारी जिम्मेदारी है",
      "startMs": "299312",
      "endMs": "301092",
      "startTimeText": "4:59"
    },
    {
      "text": "और केवल हम ही एक बड़ा अंतर ला सकते हैं।",
      "startMs": "301262",
      "endMs": "304572",
      "startTimeText": "5:01"
    },
    {
      "text": "इसलिए देवियों और सज्जनों, कार्रवाई करें और श्रेय की प्रतीक्षा न करें।",
      "startMs": "306182",
      "endMs": "310582",
      "startTimeText": "5:06"
    },
    {
      "text": "शामिल होने का खूबसूरत एहसास इसके लायक है।",
      "startMs": "311102",
      "endMs": "314482",
      "startTimeText": "5:11"
    },
    {
      "text": "अच्छा करने का मानवीय मूल्य जल्द ही चुक जाएगा",
      "startMs": "315002",
      "endMs": "318422",
      "startTimeText": "5:15"
    },
    {
      "text": "और आप भीतर से बेहतर महसूस करेंगे और उम्मीद है कि आप और अधिक करेंगे।",
      "startMs": "318722",
      "endMs": "322352",
      "startTimeText": "5:18"
    },
    {
      "text": "के प्रयासों का समर्थन करने के लिए धन्यवाद",
      "startMs": "323922",
      "endMs": "325802",
      "startTimeText": "5:23"
    },
    {
      "text": "अलवलीद फाउंडेशन और बीएमजी फाउंडेशन",
      "startMs": "325802",
      "endMs": "328532",
      "startTimeText": "5:25"
    },
    {
      "text": "एक महत्वपूर्ण मूल्य, हमारी मानवता को प्रोत्साहित करने के लिए,",
      "startMs": "328972",
      "endMs": "332092",
      "startTimeText": "5:28"
    },
    {
      "text": "एक महत्वपूर्ण संसाधन, हमारे पानी को बनाए रखने के लिए।",
      "startMs": "332422",
      "endMs": "335272",
      "startTimeText": "5:32"
    },
    {
      "text": "हमारी शानदार दोपहर का आनंद लेने के बाद,",
      "startMs": "336352",
      "endMs": "338732",
      "startTimeText": "5:36"
    },
    {
      "text": "कृपया इस एक साधारण नोट के साथ जाएं।",
      "startMs": "339092",
      "endMs": "342432",
      "startTimeText": "5:39"
    },
    {
      "text": "आप कुछ कर सकते है।",
      "startMs": "343302",
      "endMs": "344982",
      "startTimeText": "5:43"
    },
    {
      "text": "और याद रखें, हर कोई सक्षम है और कोई भी प्रतिरक्षा नहीं है।",
      "startMs": "345522",
      "endMs": "350352",
      "startTimeText": "5:45"
    },
    {
      "text": "एक सकारात्मक नोट पर जाने के लिए,",
      "startMs": "351062",
      "endMs": "352512",
      "startTimeText": "5:51"
    },
    {
      "text": "मैं देख सकता हूं कि घोड़े गर्म हो रहे हैं",
      "startMs": "352512",
      "endMs": "354182",
      "startTimeText": "5:52"
    },
    {
      "text": "और मुझे आशा है कि आपका दिन अच्छा रहे और मैच का आनंद लें।",
      "startMs": "354742",
      "endMs": "357812",
      "startTimeText": "5:54"
    },
    {
      "text": "आप सभी को धन्यवाद।",
      "startMs": "357922",
      "endMs": "358772",
      "startTimeText": "5:57"
    }
  ],
